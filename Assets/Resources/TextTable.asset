  - Key: item.runed-blade.name
    Values:
    - Runed Blade
    Reviewed: 0
    Note: 
  - Key: item.shadowweave-cloak.name
    Values:
    - Shadowweave Cloak
    Reviewed: 0
    Note: 
  - Key: item.shadowweave-cloak.description
    Values:
    - Cloth that drinks the light. One of four Shadowweave pieces.
    Reviewed: 0
    Note: 
  - Key: item.shadowweave-gloves.name
    Values:
    - Shadowweave Gloves
    Reviewed: 0
    Note: 
  - Key: item.shadowweave-gloves.description
    Values:

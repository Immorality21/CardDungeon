%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 313dbe743b6937a49a1c20cd0683f1ca, type: 3}
  m_Name: TextTable
  m_EditorClassIdentifier: CardDungeon::ImmoralityGaming.Localization.TextTableSO
  Languages:
  - en
  Entries:
  - Key: hero.cleric.name
    Values:
    - Cleric
    Reviewed: 0
    Note: 
  - Key: hero.cleric.description
    Values:
    - Keeps everyone else standing, and is quietly dangerous to the wrong things.
    Reviewed: 0
    Note: 
  - Key: hero.cultist.name
    Values:
    - Cultist
    Reviewed: 0
    Note: 
  - Key: hero.cultist.description
    Values:
    - Speaks to things that should not answer. They answer.
    Reviewed: 0
    Note: 
  - Key: hero.mage.name
    Values:
    - Mage
    Reviewed: 0
    Note: 
  - Key: hero.mage.description
    Values:
    - Commands fire, frost and storm, and is rarely careful about which.
    Reviewed: 0
    Note: 
  - Key: hero.paladin.name
    Values:
    - Paladin
    Reviewed: 0
    Note: 
  - Key: hero.paladin.description
    Values:
    - Armoured, patient, and certain. Holds a line, or breaks one, or mends it.
    Reviewed: 0
    Note: 
  - Key: hero.ranger.name
    Values:
    - Ranger
    Reviewed: 0
    Note: 
  - Key: hero.ranger.description
    Values:
    - Reads the room before anyone else has finished walking into it.
    Reviewed: 0
    Note: 
  - Key: hero.rogue.name
    Values:
    - Rogue
    Reviewed: 0
    Note: 
  - Key: hero.rogue.description
    Values:
    - Ends fights early, or is somewhere else by the time they get going.
    Reviewed: 0
    Note: 
  - Key: hero.tinkerer.name
    Values:
    - Tinkerer
    Reviewed: 0
    Note: 
  - Key: hero.tinkerer.description
    Values:
    - Solves most problems with something she brought, and the rest with something
      she makes.
    Reviewed: 0
    Note: 
  - Key: hero.warlock.name
    Values:
    - Warlock
    Reviewed: 0
    Note: 
  - Key: hero.warlock.description
    Values:
    - Has found that the shortest route to power runs straight through himself.
    Reviewed: 0
    Note: 
  - Key: hero.warrior.name
    Values:
    - Warrior
    Reviewed: 0
    Note: 
  - Key: hero.warrior.description
    Values:
    - 'A fighter in heart and essence. '
    Reviewed: 0
    Note: 
  - Key: ability.absolution.name
    Values:
    - Absolution
    Reviewed: 0
    Note: 
  - Key: ability.absolution.description
    Values:
    - 'The blessing finishes what it started: wounds close, and whatever clings to
      them lets go.'
    Reviewed: 0
    Note: 
  - Key: ability.aegis.name
    Values:
    - Aegis
    Reviewed: 0
    Note: 
  - Key: ability.aegis.description
    Values:
    - 'Divine protection over the whole line: the next hit on each of them is turned
      aside.'
    Reviewed: 0
    Note: 'UPDATE of existing row: Aegis is now the awakened Divine Protection (party-wide)'
  - Key: ability.aimed-shot.name
    Values:
    - Aimed Shot
    Reviewed: 0
    Note: 
  - Key: ability.aimed-shot.description
    Values:
    - One shot, taken slowly, that goes exactly where it was sent.
    Reviewed: 0
    Note: 
  - Key: ability.arrow-storm.name
    Values:
    - Arrow Storm
    Reviewed: 0
    Note: 
  - Key: ability.arrow-storm.description
    Values:
    - The sky goes dark with shafts, and every one of them draws blood.
    Reviewed: 0
    Note: 
  - Key: ability.backstab.name
    Values:
    - Backstab
    Reviewed: 0
    Note: 
  - Key: ability.backstab.description
    Values:
    - A short blade, put somewhere armour was never made to cover.
    Reviewed: 0
    Note: 
  - Key: ability.benediction.name
    Values:
    - Benediction
    Reviewed: 0
    Note: 
  - Key: ability.benediction.description
    Values:
    - A blessing spoken over the whole line at once.
    Reviewed: 0
    Note: 
  - Key: ability.bloodbolt.name
    Values:
    - Bloodbolt
    Reviewed: 0
    Note: 
  - Key: ability.bloodbolt.description
    Values:
    - Power taken from the only source you are certain of.
    Reviewed: 0
    Note: 
  - Key: ability.blood-circle.name
    Values:
    - Blood Circle
    Reviewed: 0
    Note: 
  - Key: ability.blood-circle.description
    Values:
    - The circle drinks what he paid, and gives it back to those inside.
    Reviewed: 0
    Note: 
  - Key: ability.blood-pact.name
    Values:
    - Blood Pact
    Reviewed: 0
    Note: 
  - Key: ability.blood-pact.description
    Values:
    - 'A bargain sealed in the Warlock''s blood: the ally it names burns brighter
      for a while.'
    Reviewed: 0
    Note: 
  - Key: ability.blood-rite.name
    Values:
    - Blood Rite
    Reviewed: 0
    Note: 
  - Key: ability.blood-rite.description
    Values:
    - Every hand in the party bleeds a little, and strikes harder for it.
    Reviewed: 0
    Note: 
  - Key: ability.blood-shower.name
    Values:
    - Blood Shower
    Reviewed: 0
    Note: 
  - Key: ability.blood-shower.description
    Values:
    - He opens his veins over the whole room, and it falls on them like rain.
    Reviewed: 0
    Note: 
  - Key: ability.bulwark.name
    Values:
    - Bulwark
    Reviewed: 0
    Note: 
  - Key: ability.bulwark.description
    Values:
    - You plant yourself, and the whole line holds behind you.
    Reviewed: 0
    Note: 
  - Key: ability.chain-lightning.name
    Values:
    - Chain Lightning
    Reviewed: 0
    Note: 
  - Key: ability.chain-lightning.description
    Values:
    - Lightning leaps from foe to foe, striking every enemy.
    Reviewed: 0
    Note: 
  - Key: ability.cleave.name
    Values:
    - Cleave
    Reviewed: 0
    Note: 
  - Key: ability.cleave.description
    Values:
    - A wide, heavy swing that catches every enemy in front of you.
    Reviewed: 0
    Note: 
  - Key: ability.cluster-bomb.name
    Values:
    - Cluster Bomb
    Reviewed: 0
    Note: 
  - Key: ability.cluster-bomb.description
    Values:
    - The shell splits in the air. Every piece has its own fuse, and every one of
      them is lit.
    Reviewed: 0
    Note: 
  - Key: ability.consecrate.name
    Values:
    - Consecrate
    Reviewed: 0
    Note: 
  - Key: ability.consecrate.description
    Values:
    - The ground itself turns against everything standing on it.
    Reviewed: 0
    Note: 
  - Key: ability.crimson-rain.name
    Values:
    - Crimson Rain
    Reviewed: 0
    Note: 
  - Key: ability.crimson-rain.description
    Values:
    - The rain does not stop where it lands. Whatever has blood keeps losing it.
    Reviewed: 0
    Note: 
  - Key: ability.dark-communion.name
    Values:
    - Dark Communion
    Reviewed: 0
    Note: 
  - Key: ability.dark-communion.description
    Values:
    - They share what he paid for. It keeps them standing.
    Reviewed: 0
    Note: 
  - Key: ability.dark-pact.name
    Values:
    - Dark Pact
    Reviewed: 0
    Note: 
  - Key: ability.dark-pact.description
    Values:
    - A better bargain with a worse partner.
    Reviewed: 0
    Note: 
  - Key: ability.dark-pact-ii.name
    Values:
    - Dark Pact II
    Reviewed: 0
    Note: 
  - Key: ability.dark-pact-ii.description
    Values:
    - The terms grow kinder. The one offering them does not.
    Reviewed: 0
    Note: 
  - Key: ability.dead-silence.name
    Values:
    - Dead Silence
    Reviewed: 0
    Note: 
  - Key: ability.dead-silence.description
    Values:
    - One word, and the whole room forgets how to speak.
    Reviewed: 0
    Note: 
  - Key: ability.deluge.name
    Values:
    - Deluge
    Reviewed: 0
    Note: 
  - Key: ability.deluge.description
    Values:
    - A wall of water crashes over every enemy and leaves them wading.
    Reviewed: 0
    Note: 
  - Key: ability.disassemble.name
    Values:
    - Disassemble
    Reviewed: 0
    Note: 
  - Key: ability.disassemble.description
    Values:
    - Wrench in hand, she finds the bolt that holds the whole thing together - and
      pulls it.
    Reviewed: 0
    Note: 
  - Key: ability.divine-bolt.name
    Values:
    - Divine Bolt
    Reviewed: 0
    Note: 
  - Key: ability.divine-bolt.description
    Values:
    - A lance of light thrown at one foe.
    Reviewed: 0
    Note: 
  - Key: ability.drain-life.name
    Values:
    - Drain Life
    Reviewed: 0
    Note: 
  - Key: ability.drain-life.description
    Values:
    - The wound closes on the wrong side.
    Reviewed: 0
    Note: 
  - Key: ability.dread.name
    Values:
    - Dread
    Reviewed: 0
    Note: 
  - Key: ability.dread.description
    Values:
    - The room remembers something it should not.
    Reviewed: 0
    Note: 
  - Key: ability.eldritch-lash.name
    Values:
    - Eldritch Lash
    Reviewed: 0
    Note: 
  - Key: ability.eldritch-lash.description
    Values:
    - Something answers when he points.
    Reviewed: 0
    Note: 
  - Key: ability.eviscerate.name
    Values:
    - Eviscerate
    Reviewed: 0
    Note: 
  - Key: ability.eviscerate.description
    Values:
    - She finds the wound that is already there, and makes it worse.
    Reviewed: 0
    Note: 
  - Key: ability.fence.name
    Values:
    - Fence
    Reviewed: 0
    Note: 
  - Key: ability.fence.description
    Values:
    - She already knows who will buy it, and for how much.
    Reviewed: 0
    Note: 
  - Key: ability.finishing-blow.name
    Values:
    - Finishing Blow
    Reviewed: 0
    Note: 
  - Key: ability.finishing-blow.description
    Values:
    - He has been waiting for it to stumble.
    Reviewed: 0
    Note: 
  - Key: ability.fireball.name
    Values:
    - Fireball
    Reviewed: 0
    Note: 
  - Key: ability.fireball.description
    Values:
    - Hurls a ball of fire at an enemy.
    Reviewed: 0
    Note: 
  - Key: ability.fire-cloak.name
    Values:
    - Fire Cloak
    Reviewed: 0
    Note: 
  - Key: ability.fire-cloak.description
    Values:
    - Sheathes the caster in a fire-warding ward.
    Reviewed: 0
    Note: 
  - Key: ability.flare-cannon.name
    Values:
    - Flare Cannon
    Reviewed: 0
    Note: 
  - Key: ability.flare-cannon.description
    Values:
    - A hand cannon loaded with a magnesium flare. Bright, loud and very hot.
    Reviewed: 0
    Note: 
  - Key: ability.flushing-shot.name
    Values:
    - Flushing Shot
    Reviewed: 0
    Note: 
  - Key: ability.flushing-shot.description
    Values:
    - An arrow that drives its quarry out of cover and off its stride.
    Reviewed: 0
    Note: 
  - Key: ability.frost-cloak.name
    Values:
    - Frost Cloak
    Reviewed: 0
    Note: 
  - Key: ability.frost-cloak.description
    Values:
    - A rime of frost turns the cold aside.
    Reviewed: 0
    Note: 
  - Key: ability.gear-jam.name
    Values:
    - Gear Jam
    Reviewed: 0
    Note: 
  - Key: ability.gear-jam.description
    Values:
    - A spanner thrown into the works. Whatever it hits loses its rhythm.
    Reviewed: 0
    Note: 
  - Key: ability.hallowed-ground.name
    Values:
    - Hallowed Ground
    Reviewed: 0
    Note: 
  - Key: ability.hallowed-ground.description
    Values:
    - The ground remembers it is holy. The dead burn on it twice over.
    Reviewed: 0
    Note: 
  - Key: ability.hamstring.name
    Values:
    - Hamstring
    Reviewed: 0
    Note: 
  - Key: ability.hamstring.description
    Values:
    - A cut behind the knee. It will not be chasing anyone.
    Reviewed: 0
    Note: 
  - Key: ability.heavenly-fire.name
    Values:
    - Heavenly Fire
    Reviewed: 0
    Note: 
  - Key: ability.heavenly-fire.description
    Values:
    - The holy ground catches. Everything standing on it keeps burning.
    Reviewed: 0
    Note: 
  - Key: ability.holy-strike.name
    Values:
    - Holy Strike
    Reviewed: 0
    Note: 
  - Key: ability.holy-strike.description
    Values:
    - A blow wreathed in holy light, against a single enemy.
    Reviewed: 0
    Note: 
  - Key: ability.holy-touch.name
    Values:
    - Holy Touch
    Reviewed: 0
    Note: 
  - Key: ability.holy-touch.description
    Values:
    - A steadying hand. Restores health to one ally, or to yourself.
    Reviewed: 0
    Note: 
  - Key: ability.hunters-mark.name
    Values:
    - Hunter's Mark
    Reviewed: 0
    Note: 
  - Key: ability.hunters-mark.description
    Values:
    - He picks one, and from then on everyone knows which.
    Reviewed: 0
    Note: 
  - Key: ability.hush.name
    Values:
    - Hush
    Reviewed: 0
    Note: 
  - Key: ability.hush.description
    Values:
    - Smothers a foe's voice, sealing its abilities for a few turns.
    Reviewed: 0
    Note: 
  - Key: ability.ice-shard.name
    Values:
    - Ice Shard
    Reviewed: 0
    Note: 
  - Key: ability.ice-shard.description
    Values:
    - Launches a razor-sharp shard of ice at a single enemy.
    Reviewed: 0
    Note: 
  - Key: ability.incendiary-bomb.name
    Values:
    - Incendiary Bomb
    Reviewed: 0
    Note: 
  - Key: ability.incendiary-bomb.description
    Values:
    - A brass shell packed with coal dust and a short fuse.
    Reviewed: 0
    Note: 
  - Key: ability.inferno.name
    Values:
    - Inferno
    Reviewed: 0
    Note: 
  - Key: ability.inferno.description
    Values:
    - The fireball does not go out. Everything it touches keeps burning.
    Reviewed: 0
    Note: 
  - Key: ability.inspire.name
    Values:
    - Inspire
    Reviewed: 0
    Note: 
  - Key: ability.inspire.description
    Values:
    - A word of faith that gives an ally back what they spent.
    Reviewed: 0
    Note: 
  - Key: ability.leeching-curse.name
    Values:
    - Leeching Curse
    Reviewed: 0
    Note: 
  - Key: ability.leeching-curse.description
    Values:
    - Every wound you open on it, he drinks from.
    Reviewed: 0
    Note: 
  - Key: ability.life-tap.name
    Values:
    - Life Tap
    Reviewed: 0
    Note: 
  - Key: ability.life-tap.description
    Values:
    - Blood spent is power regained.
    Reviewed: 0
    Note: 
  - Key: ability.lightning-bolt.name
    Values:
    - Lightning Bolt
    Reviewed: 0
    Note: 
  - Key: ability.lightning-bolt.description
    Values:
    - Strikes an enemy with a crackling bolt of lightning.
    Reviewed: 0
    Note: 
  - Key: ability.maim.name
    Values:
    - Maim
    Reviewed: 0
    Note: 
  - Key: ability.maim.description
    Values:
    - A cut across the sword arm. It will not swing as hard again.
    Reviewed: 0
    Note: 
  - Key: ability.mend.name
    Values:
    - Mend
    Reviewed: 0
    Note: 
  - Key: ability.mend.description
    Values:
    - A quiet word and a steady hand. Restores health to one ally, or to herself.
    Reviewed: 0
    Note: 
  - Key: ability.mind-rot.name
    Values:
    - Mind Rot
    Reviewed: 0
    Note: 
  - Key: ability.mind-rot.description
    Values:
    - It spreads from the inside.
    Reviewed: 0
    Note: 
  - Key: ability.mug.name
    Values:
    - Mug
    Reviewed: 0
    Note: 
  - Key: ability.mug.description
    Values:
    - A knee to the gut, and a hand in the purse on the way past.
    Reviewed: 0
    Note: 
  - Key: ability.oil-flask.name
    Values:
    - Oil Flask
    Reviewed: 0
    Note: 
  - Key: ability.oil-flask.description
    Values:
    - A corked flask of black machine oil. It slows whatever it lands on, and it
      burns beautifully.
    Reviewed: 0
    Note: 
  - Key: ability.patch-kit.name
    Values:
    - Patch Kit
    Reviewed: 0
    Note: 
  - Key: ability.patch-kit.description
    Values:
    - Rivets, brass plates and a dab of grease. Not medicine, exactly, but it holds.
    Reviewed: 0
    Note: 
  - Key: ability.poison-dart.name
    Values:
    - Poison Dart
    Reviewed: 0
    Note: 
  - Key: ability.poison-dart.description
    Values:
    - A toxic dart that damages and poisons an enemy.
    Reviewed: 0
    Note: 
  - Key: ability.press-the-attack.name
    Values:
    - Press the Attack
    Reviewed: 0
    Note: 
  - Key: ability.press-the-attack.description
    Values:
    - Two blows before it has its guard back up.
    Reviewed: 0
    Note: 
  - Key: ability.purge.name
    Values:
    - Purge
    Reviewed: 0
    Note: 
  - Key: ability.purge.description
    Values:
    - Light poured over every enemy. The dead burn twice as bright.
    Reviewed: 0
    Note: 
  - Key: ability.quicken.name
    Values:
    - Quicken
    Reviewed: 0
    Note: 
  - Key: ability.quicken.description
    Values:
    - A blessing on an ally's step. They act sooner, and more often.
    Reviewed: 0
    Note: 
  - Key: ability.rallying-roar.name
    Values:
    - Rallying Roar
    Reviewed: 0
    Note: 
  - Key: ability.rallying-roar.description
    Values:
    - A roar that shakes the walls. Every ally hits harder and moves quicker.
    Reviewed: 0
    Note: 
  - Key: ability.renew.name
    Values:
    - Renew
    Reviewed: 0
    Note: 
  - Key: ability.renew.description
    Values:
    - Knits an ally's wounds a little at a time.
    Reviewed: 0
    Note: 
  - Key: ability.renewal.name
    Values:
    - Renewal
    Reviewed: 0
    Note: 
  - Key: ability.renewal.description
    Values:
    - The mending spreads to everyone he can reach.
    Reviewed: 0
    Note: 
  - Key: ability.revive.name
    Values:
    - Revive
    Reviewed: 0
    Note: 
  - Key: ability.revive.description
    Values:
    - Calls a fallen ally back to their feet.
    Reviewed: 0
    Note: 
  - Key: ability.rite-of-warding.name
    Values:
    - Rite of Warding
    Reviewed: 0
    Note: 
  - Key: ability.rite-of-warding.description
    Values:
    - A circle drawn in his own blood. Nothing crosses it lightly.
    Reviewed: 0
    Note: 
  - Key: ability.rivet-gun.name
    Values:
    - Rivet Gun
    Reviewed: 0
    Note: 
  - Key: ability.rivet-gun.description
    Values:
    - A pressurised spike of hot iron, fired at whatever is closest.
    Reviewed: 0
    Note: 
  - Key: ability.rivet-storm.name
    Values:
    - Rivet Storm
    Reviewed: 0
    Note: 
  - Key: ability.rivet-storm.description
    Values:
    - She stops aiming. The gun empties itself into the room, one hot rivet after
      another.
    Reviewed: 0
    Note: 
  - Key: ability.sacred-shield.name
    Values:
    - Sacred Shield
    Reviewed: 0
    Note: 
  - Key: ability.sacred-shield.description
    Values:
    - A ward of light that takes the next blows in an ally's place.
    Reviewed: 0
    Note: 
  - Key: ability.sanctuary.name
    Values:
    - Sanctuary
    Reviewed: 0
    Note: 
  - Key: ability.sanctuary.description
    Values:
    - Holy ground under the whole line. Every blow lands a little softer.
    Reviewed: 0
    Note: 
  - Key: ability.searing-light.name
    Values:
    - Searing Light
    Reviewed: 0
    Note: 
  - Key: ability.searing-light.description
    Values:
    - Light too bright to speak through.
    Reviewed: 0
    Note: 
  - Key: ability.shadowstep.name
    Values:
    - Shadowstep
    Reviewed: 0
    Note: 
  - Key: ability.shadowstep.description
    Values:
    - The blow lands where she was standing.
    Reviewed: 0
    Note: 
  - Key: ability.shield-up.name
    Values:
    - Shield Up
    Reviewed: 0
    Note: 
  - Key: ability.shield-up.description
    Values:
    - Raises a sturdy shield, boosting defense and drawing the enemy's eye.
    Reviewed: 0
    Note: 
  - Key: ability.siphon-soul.name
    Values:
    - Siphon Soul
    Reviewed: 0
    Note: 
  - Key: ability.siphon-soul.description
    Values:
    - Every heart in the room beats a little for him.
    Reviewed: 0
    Note: 
  - Key: ability.slash.name
    Values:
    - Slash
    Reviewed: 0
    Note: 
  - Key: ability.slash.description
    Values:
    - A swift blade strike against a single enemy.
    Reviewed: 0
    Note: 
  - Key: ability.smoke-bomb.name
    Values:
    - Smoke Bomb
    Reviewed: 0
    Note: 
  - Key: ability.smoke-bomb.description
    Values:
    - Nobody can hit what nobody can see.
    Reviewed: 0
    Note: 
  - Key: ability.snare.name
    Values:
    - Snare
    Reviewed: 0
    Note: 
  - Key: ability.snare.description
    Values:
    - Cord and tension, left where something heavy is about to step.
    Reviewed: 0
    Note: 
  - Key: ability.soul-feast.name
    Values:
    - Soul Feast
    Reviewed: 0
    Note: 
  - Key: ability.soul-feast.description
    Values:
    - What he takes from the room, he sets before the whole table.
    Reviewed: 0
    Note: 
  - Key: ability.steal.name
    Values:
    - Steal
    Reviewed: 0
    Note: 
  - Key: ability.steal.description
    Values:
    - Whatever it was carrying, she is carrying now.
    Reviewed: 0
    Note: 
  - Key: ability.steam-burst.name
    Values:
    - Steam Burst
    Reviewed: 0
    Note: 
  - Key: ability.steam-burst.description
    Values:
    - She opens every valve at once. Scalding steam fills the room and nobody can
      see their feet.
    Reviewed: 0
    Note: 
  - Key: ability.storm-cloak.name
    Values:
    - Storm Cloak
    Reviewed: 0
    Note: 
  - Key: ability.storm-cloak.description
    Values:
    - Grounds the caster against the storm.
    Reviewed: 0
    Note: 
  - Key: ability.sunder.name
    Values:
    - Sunder
    Reviewed: 0
    Note: 
  - Key: ability.sunder.description
    Values:
    - A brutal overhead blow that splits armour as readily as flesh.
    Reviewed: 0
    Note: 
  - Key: ability.tempest.name
    Values:
    - Tempest
    Reviewed: 0
    Note: 
  - Key: ability.tempest.description
    Values:
    - The storm stops choosing. Lightning tears through every enemy at once.
    Reviewed: 0
    Note: 
  - Key: ability.terror.name
    Values:
    - Terror
    Reviewed: 0
    Note: 
  - Key: ability.terror.description
    Values:
    - The room remembers, and some of them cannot bear it.
    Reviewed: 0
    Note: 
  - Key: ability.unbroken-line.name
    Values:
    - Unbroken Line
    Reviewed: 0
    Note: 
  - Key: ability.unbroken-line.description
    Values:
    - You plant yourself, and the line does more than hold - it mends behind you.
    Reviewed: 0
    Note: 
  - Key: ability.vanish.name
    Values:
    - Vanish
    Reviewed: 0
    Note: 
  - Key: ability.vanish.description
    Values:

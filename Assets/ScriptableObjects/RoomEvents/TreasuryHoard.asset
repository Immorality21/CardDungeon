%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2774e2128e940c2ba863d0a3b1314ce, type: 3}
  m_Name: TreasuryHoard
  m_EditorClassIdentifier: CardDungeon::Assets.Scripts.Rooms.Events.RoomEventSO
  Key: TreasuryHoard
  Title: 'The Treasury'
  Prompt: 'Strongboxes line the walls, prised open and emptied a long time ago. There is loose coin
    in the corners for anyone patient enough to go along the shelves - and one gilded chest, lock
    already sprung, that nobody has touched.'
  GoverningStat: 6
  SpawnChancePercent: 50
  SpawnModifierStat: 6
  SpawnModifierRate: 2
  Difficulty: 8
  Options:
  - Label: 'Gather the loose coin'
    Kind: 1
    DeclineText: ''
    Success:
    - Text: 'You work along the shelves and come away with a respectable double handful. The gilded
        chest is still sitting there, still untouched, as you leave.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 15
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure: []
  - Label: 'Throw the lid back on the gilded chest'
    Kind: 0
    DeclineText: ''
    Success:
    - Text: 'The lid swings clear of a needle you never saw. Underneath: coin, and gear somebody else
        did not live to use.'
      Weight: 3
      WeightModifierStat: 6
      WeightModifierRate: 5
      Effects: []
      Targets: 0
      LootTable:
      - {fileID: 11400000, guid: 48143a77cb3b71041a7cbf5a38862834, type: 2}
      - {fileID: 11400000, guid: 77a107a8fa4807a4782e3b6cfa65505e, type: 2}
      - {fileID: 11400000, guid: 49f583fd473ca6144819051f4d6a6f7d, type: 2}
      Gold: 30
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'Empty, but for a purse wedged under the lining.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 15
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure:
    - Text: 'The needle goes in above the knuckle. Whatever was on it burns all the way up the arm,
        and does not stop burning.'
      Weight: 2
      WeightModifierStat: 6
      WeightModifierRate: -5
      Effects:
      - EffectType: 0
        Power: 4
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      - EffectType: 3
        Power: 2
        ScalingStat: 0
        DamageType: 0
        BuffType: 1
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'The lid comes back on a spring and the crack of it goes down every corridor on this
        floor. Something answers.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies:
      - {fileID: 11400000, guid: ce571ba2b36e6c14bb37279e004b146c, type: 2}
  - Label: 'Take nothing and move on'
    Kind: 2
    DeclineText: 'You leave the shelves and the chest exactly as you found them.'
    Success: []
    Failure: []

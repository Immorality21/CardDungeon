--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2774e2128e940c2ba863d0a3b1314ce, type: 3}
  m_Name: DrownedOffering
  m_EditorClassIdentifier: CardDungeon::Assets.Scripts.Rooms.Events.RoomEventSO
  Key: DrownedOffering
  Title: 'A Drowned Offering'
  Prompt: 'Knee-deep in the standing water, a stone bowl still holds its offering: coins, teeth, something folded in oilcloth. The water around it is warmer than the water around your boots.'
  GoverningStat: 5
  SpawnChancePercent: 8
  SpawnModifierStat: 5
  SpawnModifierRate: 5
  SpawnRequirements:
  - Type: 5
    Amount: 6
  Difficulty: 10
  Options:
  - Label: 'Kneel and say the words'
    Kind: 0
    DeclineText: ''
    Success:
    - Text: 'The warmth comes up out of the bowl and goes through all of you. Old wounds close over. Whatever is owed here has been paid before.'
      Weight: 3
      Effects:
      - EffectType: 1
        Power: 6
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      Targets: 1
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'Nothing answers, but the folded oilcloth is worth having.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable:
      - {fileID: 11400000, guid: 0af466e4089275b4d9535cd9f2710019, type: 2}
      Gold: 10
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure:
    - Text: 'You get the words wrong. The water goes cold, the taste of it gets into everyone, and the whole party feels thinner for it.'
      Weight: 2
      Effects:
      - EffectType: 3
        Power: 2
        ScalingStat: 0
        DamageType: 0
        BuffType: 5
        Duration: 3
        UnlockLevel: 0
      Targets: 1
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'The bowl tips. Something in the reeds decides it has been insulted.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies:
      - {fileID: 11400000, guid: d43f3a83da179484091d957b352a4b13, type: 2}
  - Label: 'Take the coins and go'
    Kind: 1
    DeclineText: ''
    Success:
    - Text: 'You pocket the coins without ceremony. The water stays cold behind you the whole way out.'
      Weight: 1
      Effects:
      - EffectType: 3
        Power: 1
        ScalingStat: 0
        DamageType: 0
        BuffType: 5
        Duration: 3
        UnlockLevel: 0
      Targets: 1
      LootTable: []
      Gold: 20
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure: []
  - Label: 'Leave the bowl alone'
    Kind: 2
    DeclineText: 'You keep your hands to yourself and wade on past.'
    Success: []
    Failure: []

  m_Script: {fileID: 11500000, guid: e2774e2128e940c2ba863d0a3b1314ce, type: 3}
  m_Name: SealedTomb
  m_EditorClassIdentifier: CardDungeon::Assets.Scripts.Rooms.Events.RoomEventSO
  Key: SealedTomb
  Title: 'A Sealed Tomb'
  Prompt: 'A slab of stone has been dragged over a hole in the cavern floor and mortared down at the edges. Somebody wanted this shut. The mortar is old, and the slab has a lip you could get your hands under.'
  Trigger: 1
  GoverningStat: 1
  Difficulty: 10
  Options:
  - Label: 'Heave the slab aside'
    Kind: 0
    DeclineText: ''
    Success:
    - Text: 'The mortar goes with a crack and the slab slides. Below: a body in good armour that has not needed it for a century.'
      Weight: 3
      Effects: []
      Targets: 0
      LootTable:
      - {fileID: 11400000, guid: d584e10d49b161a4ebb6040a496455d6, type: 2}
      - {fileID: 11400000, guid: 098bb76c9957858418ab9ec1d033fcd7, type: 2}
      Gold: 15
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'It shifts far enough. You come up with a sword and a badly wrenched shoulder.'
      Weight: 1
      Effects:
      - EffectType: 0
        Power: 3
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable:
      - {fileID: 11400000, guid: 098bb76c9957858418ab9ec1d033fcd7, type: 2}
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure:
    - Text: 'The slab comes back on your fingers and the whole cavern hears about it. Whatever was sealed in was not the only thing down here.'
      Weight: 2
      Effects:
      - EffectType: 0
        Power: 3
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies:
      - {fileID: 11400000, guid: ce571ba2b36e6c14bb37279e004b146c, type: 2}
      - {fileID: 11400000, guid: bf6697af4924975448304c7112cc67ec, type: 2}
    - Text: 'It will not move. You leave skin on the stone for nothing.'
      Weight: 1
      Effects:
      - EffectType: 0
        Power: 4
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
  - Label: 'Leave the dead sealed'
    Kind: 2
    DeclineText: 'Somebody mortared this down for a reason. You leave the reason where it is.'
    Success: []
    Failure: []

  m_Script: {fileID: 11500000, guid: e2774e2128e940c2ba863d0a3b1314ce, type: 3}
  m_Name: GildedChest
  m_EditorClassIdentifier: CardDungeon::Assets.Scripts.Rooms.Events.RoomEventSO
  Key: GildedChest
  Title: 'A Gilded Chest'
  Prompt: 'A low chest sits alone in the middle of the floor, gilt still bright, lock already sprung. Nobody leaves a chest like this open in a place like this. There is no way to tell what is waiting under the lid.'
  Trigger: 1
  GoverningStat: 6
  Difficulty: 8
  Options:
  - Label: 'Throw the lid back'
    Kind: 0
    DeclineText: ''
    Success:
    - Text: 'The lid swings clear of a needle you never saw. Underneath: coin, and gear somebody else did not live to use.'
      Weight: 3
      Effects: []
      Targets: 0
      LootTable:
      - {fileID: 11400000, guid: 48143a77cb3b71041a7cbf5a38862834, type: 2}
      - {fileID: 11400000, guid: 77a107a8fa4807a4782e3b6cfa65505e, type: 2}
      - {fileID: 11400000, guid: 49f583fd473ca6144819051f4d6a6f7d, type: 2}
      Gold: 30
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'Empty, but for a purse wedged under the lining.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 15
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure:
    - Text: 'The needle goes in above the knuckle. Whatever was on it burns all the way up the arm, and does not stop burning.'
      Weight: 2
      Effects:
      - EffectType: 0
        Power: 4
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      - EffectType: 3
        Power: 2
        ScalingStat: 0
        DamageType: 0
        BuffType: 1
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'The lid comes back on a spring and the crack of it goes down every corridor on this floor. Something answers.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies:
      - {fileID: 11400000, guid: ce571ba2b36e6c14bb37279e004b146c, type: 2}
  - Label: 'Walk past it'
    Kind: 2
    DeclineText: 'You step around the chest and leave it grinning at the ceiling.'
    Success: []
    Failure: []

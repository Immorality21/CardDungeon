  m_Script: {fileID: 11500000, guid: e2774e2128e940c2ba863d0a3b1314ce, type: 3}
  m_Name: MustyTome
  m_EditorClassIdentifier: CardDungeon::Assets.Scripts.Rooms.Events.RoomEventSO
  Key: MustyTome
  Title: 'A Musty Tome'
  Prompt: 'A swollen leather tome lies open on a lectern, its pages furred with mould and strung across with old web. Whatever is written in it was worth writing down carefully. Something has been living in the spine for a long time.'
  Trigger: 0
  GoverningStat: 4
  Difficulty: 6
  Options:
  - Label: 'Ease it off the lectern'
    Kind: 0
    DeclineText: ''
    Success:
    - Text: 'You lift the cover clear, copy what matters, and leave the rest to the damp. A collector will pay for this.'
      Weight: 3
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 25
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'You get the pages out intact - and the thing in the spine gets a piece of you on the way past.'
      Weight: 1
      Effects:
      - EffectType: 0
        Power: 3
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 25
      LoseAConsumable: 0
      AwakenedEnemies: []
    Failure:
    - Text: 'The spine splits, the web comes alive, and something long-legged sinks its jaws in before you can pull back. The pages are ruined.'
      Weight: 2
      Effects:
      - EffectType: 0
        Power: 4
        ScalingStat: 0
        DamageType: 0
        BuffType: 0
        Duration: 3
        UnlockLevel: 0
      - EffectType: 3
        Power: 2
        ScalingStat: 0
        DamageType: 0
        BuffType: 3
        Duration: 3
        UnlockLevel: 0
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 0
      AwakenedEnemies: []
    - Text: 'The lectern gives way. You come out of the mess with nothing but a lighter pack.'
      Weight: 1
      Effects: []
      Targets: 0
      LootTable: []
      Gold: 0
      LoseAConsumable: 1
      AwakenedEnemies: []
  - Label: 'Leave it to rot'
    Kind: 2
    DeclineText: 'You leave the book to the damp. It has waited this long; it can wait longer.'
    Success: []
    Failure: []

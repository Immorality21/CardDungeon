<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Theme/CardDungeon.uss" />

    <ui:VisualElement name="root" class="cd-root">
        <ui:VisualElement name="bg" class="cd-bg" picking-mode="Ignore" />

        <!-- THE TOWN. Full-bleed rather than a cd-window: this is the screen, and every service
             below docks *over* it. The HubView widget is added into hub-town from code (it is a
             VisualElement subclass, not a UXML type) and letterboxes the authored 1280x720 rect as
             one unit, so the art and the hitboxes can never drift apart.

             The road is a plain button here rather than a BuildingSO: the story is the way out of
             town, not a service the town provides, and a building must never be able to lock the
             player out of running (HUB.md section 7, open question 4). -->
        <ui:VisualElement name="hub-view" class="hub-screen cd-hidden">
            <ui:VisualElement name="hub-town" class="hub-town">
                <ui:Button name="road-btn" text="The Story &#9654;" class="hub-road hub-road--art" />
            </ui:VisualElement>
            <!-- The town frame's bottom band, not a strip under it: it closes the frame, and the purse
                 is two chips (the number large, the currency small beneath) like a header's. -->
            <ui:VisualElement class="hub-bar">
                <ui:Button name="hub-menu-btn" text="Main Menu" class="cd-button cd-button--narrow" />
                <ui:Label name="hub-feedback" text="" class="cd-feedback" />
                <ui:VisualElement class="hub-purse">
                    <ui:VisualElement class="hub-purse__chip">
                        <ui:Label name="hub-gold" text="0" class="hub-purse__value" />
                        <ui:Label text="GOLD" class="hub-purse__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-purse__chip hub-purse__chip--essence">
                        <ui:Label name="hub-essence" text="0" class="hub-purse__value" />
                        <ui:Label text="ESSENCE" class="hub-purse__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- THE SCRIM. Between the town and a service window: the town stays on screen, dimmed and
             inert, behind the lot panel and every service (2026-09-30). It used to vanish the moment
             a lot was clicked, which lost the best-looking thing in the game and the Build sprite
             swap the lot panel exists to show. HubManager.CoverTown / ShowTown drive it. -->
        <ui:VisualElement name="hub-scrim" class="hub-scrim cd-hidden" />

        <!-- ONE LOT. Shown when a lot has something to decide - it is not built yet, or it can
             be raised a level. A finished building opens its service directly instead, because a
             panel on every merchant visit would be a tax on the common case.

             The build is confirmed HERE rather than applied on load, which is what gives the sprite
             swap something to animate (HUB.md section 7, machinery 3). -->
        <!-- One fixed px size in every state (2026-09-30): it used to be 250px unbuilt and 335px built,
             and a resized dock-centred window desyncs hit-testing. The building's picture, what it
             is, a have / need cost table, what the next level buys, then Enter / Build or Upgrade /
             Back in that order - Enter first, because it is the common action on a built lot and the
             first arrow key lands on the first button. -->
        <ui:VisualElement name="lot-view" class="cd-window cd-window--flush hub-lotpanel cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label name="lot-name" text="" class="cd-inv-header__title" />
                <ui:Label name="lot-status" text="" class="cd-camp-header__cap" />
            </ui:VisualElement>
            <ui:VisualElement class="hub-lotpanel__body">
                <ui:VisualElement name="lot-art" class="hub-lotpanel__art" />
                <ui:VisualElement class="hub-lotpanel__info">
                    <ui:Label name="lot-blurb" text="" class="cd-inv-detail__desc" />
                    <ui:Label name="lot-costs-title" text="Costs" class="cd-inv-col__title" />
                    <ui:VisualElement name="lot-costs" class="hub-lotpanel__costs" />
                    <ui:Label name="lot-grant-title" text="Next level" class="cd-inv-col__title" />
                    <ui:Label name="lot-grant" text="" class="cd-inv-detail__line hub-lotpanel__grant" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hub-lotpanel__actions">
                <ui:Button name="lot-enter" text="Enter" class="cd-inv-tab cd-camp-action" />
                <ui:Button name="lot-action" text="" class="cd-inv-tab cd-camp-action" />
                <ui:Button name="lot-close" text="Back" class="cd-inv-close hub-lotpanel__back" />
            </ui:VisualElement>
            <ui:Label name="lot-reason" text="" class="cd-reason hub-lotpanel__reason" />
            <ui:Label name="lot-feedback" text="" class="cd-camp-feedback hub-lotpanel__feedback" />
        </ui:VisualElement>

        <!-- RUN PROGRESS -->
        <!-- The "you are about to go in" moment (2026-09-30): one fixed size, the run and the floor in
             the header, a pip per floor, the party as portrait tiles, and Enter Dungeon first and
             primary - the shared cursor's first arrow lands on it. -->
        <ui:VisualElement name="progress-view" class="cd-window cd-window--flush hub-entry cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label name="level-indicator" text="" class="cd-inv-header__title" />
                <ui:Label name="level-count" text="" class="cd-camp-header__cap" />
            </ui:VisualElement>
            <ui:VisualElement class="hub-entry__body">
                <ui:Label name="level-name" text="" class="hub-entry__name" />
                <ui:VisualElement name="level-pips" class="hub-entry__pips" />
                <ui:Label name="progress-revisit" text="" class="cm-fear-summary cd-hidden" />
                <ui:Label text="Marching out" class="cd-inv-col__title hub-entry__party-title" />
                <ui:VisualElement name="progress-party-tiles" class="hub-entry__party" />
                <ui:Label name="progress-party" text="" class="cd-inv-detail__note" />
            </ui:VisualElement>
            <ui:VisualElement class="hub-lotpanel__actions hub-entry__actions">
                <ui:Button name="enter-btn" text="Enter Dungeon" class="cd-inv-tab cd-camp-action hub-entry__enter" />
                <ui:Button name="progress-party-btn" text="Change Party" class="cd-inv-tab cd-camp-action" />
                <ui:Button name="back-btn" text="Back" class="cd-inv-close hub-lotpanel__back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- RUN COMPLETE -->
        <!-- RUN COMPLETE. The victory window's frame and header band, naming the run that fell and
             what clearing it opened on the story map (HubManager.ShowRunCompletePanel fills the
             rows). It used to be the same two lines whatever run it was. -->
        <ui:VisualElement name="complete-view" class="cd-victory cd-run-complete cd-dock-center cd-hidden">
            <ui:Label text="Run Complete!" class="cd-victory__title" />
            <ui:Label name="complete-run" text="" class="cd-run-complete__run" />
            <ui:Label name="complete-message" text="" class="cd-run-complete__message" />
            <ui:VisualElement name="complete-rewards" class="cd-victory__rewards" />
            <ui:Button name="return-btn" text="Return to town" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

        <!-- MERCHANT -->
        <ui:VisualElement name="merchant-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <!-- The inventory's fixed frame, like the campfire: Buy / Sell / Potion Belt tabs, a hero
                 strip that picks who the stats are compared against, the list, and a detail column
                 carrying the price and the one action. Every region exists on every tab. -->
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Merchant" class="cd-inv-header__title" />
                <ui:VisualElement class="cd-inv-tabs">
                    <ui:Button name="merchant-tab-buy" text="Buy" class="cd-inv-tab cd-inv-tab--active" />
                    <ui:Button name="merchant-tab-sell" text="Sell" class="cd-inv-tab" />
                    <ui:Button name="merchant-tab-belt" text="Potion Belt" class="cd-inv-tab" />
                </ui:VisualElement>
                <ui:Label name="merchant-gold" text="" class="cd-camp-header__gold" />
                <ui:Button name="merchant-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>

            <ui:VisualElement name="merchant-heroes" class="cd-inv-heroes" />

            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cd-inv-col cd-shop-col--list">
                    <ui:Label name="merchant-list-title" text="" class="cd-inv-col__title" />
                    <ui:ScrollView name="merchant-list" class="cd-inv-list" mode="Vertical" />
                    <ui:Label name="merchant-empty" text="" class="cd-inv-empty cd-hidden" />
                    <ui:Button name="restock-btn" text="" class="cd-inv-tab cd-shop-restock" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-inv-col--detail cd-shop-col--detail">
                    <ui:VisualElement class="cd-inv-detail__head">
                        <ui:VisualElement name="merchant-detail-icon" class="cd-inv-detail__icon" />
                        <ui:VisualElement class="cd-inv-detail__titles">
                            <ui:Label name="merchant-detail-name" text="" class="cd-inv-detail__name" />
                            <ui:Label name="merchant-detail-sub" text="" class="cd-inv-detail__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="cd-camp-actions">
                        <ui:Button name="merchant-action" text="" class="cd-inv-tab cd-camp-action" />
                    </ui:VisualElement>
                    <ui:Label name="merchant-reason" text="" class="cd-reason" />
                    <ui:ScrollView name="merchant-detail-body" class="cd-inv-detail__body" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                    <ui:Label name="merchant-feedback" text="" class="cd-camp-feedback" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="Arrows move  ·  Enter choose  ·  Esc back" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- PARTY SELECT (the campfire). The inventory's fixed frame (cd-inv-window, 1180x720):
             every region below exists in every state, so the dock-centred window never resizes
             and hit-testing never desyncs. Seats across the top are the four places in the
             marching party; the roster is everyone owned; the detail column is the hero the
             cursor chose; the right column is how the run's XP is divided. Every control is a
             Button, so the hub's shared keyboard cursor drives the whole screen. -->
        <ui:VisualElement name="party-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Campfire" class="cd-inv-header__title" />
                <ui:Label name="party-cap" text="" class="cd-camp-header__cap" />
                <ui:Label name="party-gold" text="" class="cd-camp-header__gold" />
                <ui:Button name="party-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>

            <ui:VisualElement class="cd-inv-heroes cd-camp-seats">
                <ui:Button name="party-seat-0" class="cd-camp-seat" />
                <ui:Button name="party-seat-1" class="cd-camp-seat" />
                <ui:Button name="party-seat-2" class="cd-camp-seat" />
                <ui:Button name="party-seat-3" class="cd-camp-seat" />
                <ui:VisualElement class="cd-inv-heroes__summary" picking-mode="Ignore">
                    <ui:Label name="party-share" text="" class="cd-inv-heroes__summary-line cd-inv-heroes__summary-name" />
                    <ui:Label text="A wider party is safer; a narrower one levels faster." class="cd-inv-heroes__summary-line" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cd-inv-col cd-camp-col--roster">
                    <ui:Label text="Roster" class="cd-inv-col__title" />
                    <ui:ScrollView name="party-roster" class="cd-inv-list" mode="Vertical" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-inv-col--detail cd-camp-col--detail">
                    <ui:VisualElement class="cd-inv-detail__head">
                        <ui:VisualElement name="party-detail-icon" class="cd-inv-detail__icon" />
                        <ui:VisualElement class="cd-inv-detail__titles">
                            <ui:Label name="party-detail-name" text="" class="cd-inv-detail__name" />
                            <ui:Label name="party-detail-sub" text="" class="cd-inv-detail__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="cd-camp-actions">
                        <ui:Button name="party-toggle" text="" class="cd-inv-tab cd-camp-action" />
                        <ui:Button name="party-lead" text="Lead the party" class="cd-inv-tab cd-camp-action" />
                    </ui:VisualElement>
                    <ui:Label name="party-reason" text="" class="cd-reason" />
                    <ui:ScrollView name="party-detail-body" class="cd-inv-detail__body" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-camp-col--split">
                    <ui:Label text="Sharing the XP" class="cd-inv-col__title" />
                    <ui:Button name="party-split-even" text="Even" class="cd-inv-tab cd-camp-mode" />
                    <ui:Button name="party-split-mentor" text="Mentor" class="cd-inv-tab cd-camp-mode" />
                    <ui:Button name="party-split-catchup" text="Catch Up" class="cd-inv-tab cd-camp-mode" />
                    <ui:Button name="party-split-focus" text="" class="cd-inv-tab cd-camp-focus" />
                    <ui:Label name="party-split-desc" text="" class="cd-camp-split-desc" />
                    <ui:Label name="party-feedback" text="" class="cd-camp-feedback" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="Arrows move  ·  Enter choose  ·  Esc back" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- FORGE -->
        <ui:VisualElement name="forge-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <!-- On the inventory frame (2026-09-30): the known abilities as a list, the chosen one's
                 detail always beside it, Upgrade in the detail column. It used to be a wall of "?"
                 tiles that swapped for an inspect page and resized the window on every click. -->
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Ability Forge" class="cd-inv-header__title" />
                <ui:VisualElement class="cd-inv-tabs">
                    <ui:Button name="forge-tab-magic" text="Abilities" class="cd-inv-tab cd-inv-tab--active" />
                    <ui:Button name="forge-tab-combos" text="Combos" class="cd-inv-tab" />
                </ui:VisualElement>
                <ui:Label name="forge-essence" text="" class="cd-camp-header__gold" />
                <ui:Button name="forge-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>

            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cd-inv-col cd-shop-col--list">
                    <ui:Label name="forge-list-title" text="" class="cd-inv-col__title" />
                    <ui:ScrollView name="forge-list" class="cd-inv-list" mode="Vertical" />
                    <ui:Label name="forge-empty" text="" class="cd-inv-empty cd-hidden" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-inv-col--detail">
                    <ui:VisualElement class="cd-inv-detail__head">
                        <ui:VisualElement name="forge-detail-icon" class="cd-inv-detail__icon" />
                        <ui:VisualElement class="cd-inv-detail__titles">
                            <ui:Label name="forge-detail-name" text="" class="cd-inv-detail__name" />
                            <ui:Label name="forge-detail-sub" text="" class="cd-inv-detail__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="cd-camp-actions">
                        <ui:Button name="forge-upgrade" text="Upgrade" class="cd-inv-tab cd-camp-action" />
                    </ui:VisualElement>
                    <ui:Label name="forge-reason" text="" class="cd-reason" />
                    <ui:ScrollView name="forge-detail-body" class="cd-inv-detail__body" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                    <ui:Label name="forge-feedback" text="" class="cd-camp-feedback sg-feedback" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="Arrows move  ·  Enter choose  ·  Esc back" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- BESTIARY -->
        <!-- Fixed height for the same reason the inventory is: the detail column changes size as
             enemies are selected, and a translate-centered window that resizes leaves UITK's input
             hit-testing on the old transform, offsetting every click. -->
        <!-- On the inventory frame (2026-09-30): met enemies as rows, the unmet folded into compact
             rows at the bottom, and the chosen one's page beside the list - portrait and name on top,
             then two columns so a normal entry never scrolls. Keeps its own Up/Down cursor. -->
        <ui:VisualElement name="bestiary-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Bestiary" class="cd-inv-header__title" />
                <ui:Label name="bestiary-progress" text="" class="cd-camp-header__cap" />
                <ui:Button name="bestiary-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cd-inv-col cd-shop-col--list">
                    <ui:Label text="Enemies met" class="cd-inv-col__title" />
                    <ui:ScrollView name="bestiary-list" class="cd-inv-list" mode="Vertical" />
                </ui:VisualElement>
                <ui:VisualElement class="cd-inv-col cd-inv-col--detail">
                    <ui:VisualElement class="cd-inv-detail__head">
                        <ui:VisualElement name="bestiary-portrait" class="cd-inv-detail__icon cd-bestiary__portrait" />
                        <ui:VisualElement class="cd-inv-detail__titles">
                            <ui:Label name="bestiary-name" text="" class="cd-inv-detail__name" />
                            <ui:Label name="bestiary-sub" text="" class="cd-inv-detail__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="bestiary-detail" class="cd-inv-detail__body" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="bestiary-hint" text="&#8593;&#8595; select  &#183;  Esc back" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- INVENTORY -->
        <!-- One fixed frame for all four tabs: header band with the tabs, the hero strip, three
             columns and a hint line. Every region is present on every tab and sized in px, so the
             dock-centred window never changes size (hit-testing follows the first layout only).
             Rows inside the columns are built by InventoryHubUI; the regions themselves live here. -->
        <ui:VisualElement name="inventory-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Inventory" class="cd-inv-header__title" />
                <ui:VisualElement name="inventory-tabs" class="cd-inv-tabs">
                    <ui:Button name="tab-equipment" text="Equipment" class="cd-inv-tab cd-inv-tab--active" />
                    <ui:Button name="tab-spells" text="Abilities" class="cd-inv-tab" />
                    <ui:Button name="tab-consumables" text="Consumables" class="cd-inv-tab" />
                    <ui:Button name="tab-materials" text="Materials" class="cd-inv-tab" />
                </ui:VisualElement>
                <ui:Button name="inventory-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>

            <ui:VisualElement name="inventory-heroes" class="cd-inv-heroes" />

            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cd-inv-col cd-inv-col--left">
                    <ui:Label name="inv-left-title" text="" class="cd-inv-col__title" />
                    <ui:VisualElement name="inv-left" class="cd-inv-col__content" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-inv-col--list">
                    <ui:Label name="inv-list-title" text="" class="cd-inv-col__title" />
                    <ui:ScrollView name="inventory-scroll" class="cd-inv-list" mode="Vertical" />
                    <ui:Label name="inventory-empty" text="" class="cd-inv-empty cd-hidden" />
                </ui:VisualElement>

                <ui:VisualElement class="cd-inv-col cd-inv-col--detail">
                    <ui:VisualElement class="cd-inv-detail__head">
                        <ui:VisualElement name="inv-detail-icon" class="cd-inv-detail__icon" />
                        <ui:VisualElement class="cd-inv-detail__titles">
                            <ui:Label name="inv-detail-name" text="" class="cd-inv-detail__name" />
                            <ui:Label name="inv-detail-sub" text="" class="cd-inv-detail__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="inv-detail-body" class="cd-inv-detail__body" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="inventory-hint" text="" class="cd-inv-hint" />
        </ui:VisualElement>


        <!-- SPHERE GRID (fixed size on both axes: the pannable graph and the always-present
             detail panel must never resize the dock-centered window, or hit-testing desyncs) -->
        <ui:VisualElement name="grid-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <!-- On the inventory frame (2026-09-30): Back in the header band, a portrait strip with
                 each hero's banked XP, and the freed height given to the pannable graph. Still one
                 fixed px size in every state, so hit-testing never desyncs. -->
            <ui:VisualElement class="cd-inv-header">
                <ui:Label text="Sphere Grid" class="cd-inv-header__title" />
                <ui:Label name="grid-xp" text="" class="cd-camp-header__cap" />
                <ui:Button name="grid-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>

            <ui:VisualElement name="grid-heroes" class="cd-inv-heroes" />

            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement name="grid-graph" class="sg-graph-host" />
                <ui:VisualElement name="grid-detail" class="cd-inv-col sg-detail-col">
                    <ui:Label name="grid-detail-name" text="Select a node." class="cd-inv-detail__name" />
                    <ui:VisualElement class="sg-detail__chips">
                        <ui:Label name="grid-detail-kind" text="" class="cd-inv-grant" />
                    </ui:VisualElement>
                    <ui:Label name="grid-detail-payload" text="" class="cd-inv-detail__desc sg-detail__payload" />
                    <ui:VisualElement name="grid-detail-body" class="sg-detail__body" />
                    <ui:Label name="grid-detail-cost" text="" class="cd-inv-detail__line sg-detail__cost" />
                    <ui:Button name="grid-activate" text="Activate" class="cd-inv-tab sg-activate" />
                    <ui:Label name="grid-reason" text="" class="cd-reason" />
                    <ui:Label name="grid-feedback" text="" class="cd-camp-feedback sg-feedback" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="grid-hint" text="Arrows move  ·  Enter activate  ·  Q/E hero  ·  Esc back  ·  drag to pan, scroll to zoom" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- CAMPAIGN MAP (fixed size on both axes, same reason as the sphere grid: a pannable
             graph inside a dock-centered window must never change the window's size) -->
        <!-- On the inventory frame (2026-09-30): Back in the header, the graph with a legend under it,
             and a detail column that says where you are in a run, every floor of it, and what
             clearing it opens. Keeps its own cursor (it pans content the shared one cannot see). -->
        <ui:VisualElement name="campaign-view" class="cd-window cd-window--flush cd-inv-window cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-inv-header">
                <ui:Label name="campaign-title" text="The Story" class="cd-inv-header__title" />
                <ui:Label text="" class="cd-camp-header__cap" />
                <ui:Button name="campaign-close" text="Back" class="cd-inv-close" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-inv-body">
                <ui:VisualElement class="cm-graph-col">
                    <ui:VisualElement name="campaign-graph" class="cm-graph-host" />
                    <ui:Label name="campaign-legend" text="&#9654; in progress  &#183;  &#9733; open  &#183;  ? side road  &#183;  &#10003; cleared  &#183;  &#128274; locked" class="cm-legend" />
                </ui:VisualElement>
                <ui:VisualElement name="campaign-detail" class="cd-inv-col cm-detail-col">
                    <ui:Label name="campaign-detail-name" text="Pick a place on the map." class="cd-inv-detail__name" />
                    <ui:Label name="campaign-detail-status" text="" class="cd-inv-detail__sub cm-detail__status" />
                    <ui:Label name="campaign-detail-blurb" text="" class="cd-inv-detail__desc" />
                    <ui:Label name="campaign-detail-requires" text="" class="cd-reason cm-detail__requires" />
                    <ui:ScrollView name="campaign-detail-body" class="cm-detail__body" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                    <ui:Label name="campaign-feedback" text="" class="cd-camp-feedback sg-feedback" />
                    <ui:Button name="campaign-start" text="Begin" class="cd-inv-tab cm-start" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="campaign-hint" text="Arrows move  &#183;  Enter begin  &#183;  Esc back  &#183;  drag to pan, scroll to zoom" class="cd-inv-hint" />
        </ui:VisualElement>

        <!-- THE TUTORIAL's one line (docs/TUTORIAL.md). Last in the document on purpose: UI
             Toolkit has no z-index, so being the final sibling is what paints it over every view.
             Never picks - the screens under it stay exactly as clickable as the tutorial says. -->
        <ui:VisualElement name="tutorial-banner" class="cd-tutorial-banner cd-hidden" picking-mode="Ignore">
            <ui:Label name="tutorial-text" text="" class="cd-tutorial-banner__text" picking-mode="Ignore" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Theme/CardDungeon.uss" />

    <ui:VisualElement name="root" class="cd-root" picking-mode="Ignore">

        <!-- Ability / slot list window (docked bottom-left, styled like the command menu) -->
        <ui:VisualElement name="magic-list-panel" class="cd-window cd-window--combat cd-window--picker cd-dock-bottom-left cd-hidden">
            <ui:Label name="list-title" text="Ability" class="cd-command-window__header" />
            <ui:ScrollView name="list-scroll" class="cd-select-scroll" mode="Vertical" />
            <!-- What the selected row does: flavour plus the generated mechanics line. -->
            <ui:Label name="list-desc" text="" class="cd-sel-desc cd-hidden" />
            <ui:Button name="list-back" text="Back" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

        <!-- Target picker window (cast target / attack target) -->
        <ui:VisualElement name="target-panel" class="cd-window cd-window--combat cd-window--picker cd-dock-bottom-left cd-hidden">
            <ui:Label name="target-prompt" text="Select Target" class="cd-command-window__header" />
            <ui:ScrollView name="target-scroll" class="cd-select-scroll" mode="Vertical" />
            <ui:Button name="target-back" text="Back" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

        <!-- Inspect ("Scan") window: everything the party has learned about one enemy. Docked
             center rather than bottom-left like the pickers - it is a page to read, not a list to
             cursor through, and it closes back to the command menu without spending the turn. -->
        <ui:VisualElement name="inspect-panel" class="cd-window cd-window--combat cd-scan-window cd-dock-center cd-hidden">
            <ui:VisualElement class="cd-scan__header">
                <ui:VisualElement name="inspect-portrait" class="cd-scan__portrait" />
                <ui:VisualElement class="cd-scan__titlecol">
                    <ui:Label name="inspect-name" text="" class="cd-scan__name" />
                    <ui:Label name="inspect-health" text="" class="cd-scan__health" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Two columns so the page reads at a glance instead of scrolling: what it is and what
                 hurts it on the left, what it is doing right now on the right. -->
            <ui:ScrollView name="inspect-body" class="cd-scan__body" mode="Vertical">
                <ui:VisualElement class="cd-scan__cols">
                    <ui:VisualElement name="inspect-col-left" class="cd-scan__col" />
                    <ui:VisualElement name="inspect-col-right" class="cd-scan__col cd-scan__col--right" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="inspect-close" text="Back" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

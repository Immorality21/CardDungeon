<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Theme/CardDungeon.uss" />

    <!-- The title screen, and nothing else. Everything the player *does* between runs lives in
         HubScene; this document is deliberately dependency-free so it can be shown before a save
         file has been chosen - which is what makes room for the save-slot picker that will land
         here later. Continue is that choice today, with one slot. -->
    <ui:VisualElement name="root" class="cd-root">
        <ui:VisualElement name="bg" class="cd-bg" picking-mode="Ignore" />

        <!-- TITLE -->
        <ui:VisualElement name="title-view" class="cd-window cd-window--flush cd-dock-center cd-hidden">
            <ui:Label text="Card Dungeon" class="cd-title cd-title--large" />
            <ui:Button name="continue-btn" text="Continue" class="cd-menu-button" />
            <ui:Button name="options-btn" text="Options" class="cd-menu-button" />
            <ui:Button name="quit-btn" text="Quit" class="cd-menu-button" />
        </ui:VisualElement>

        <!-- OPTIONS (audio). Stepped buttons rather than sliders so the keyboard cursor, which
             navigates buttons, can reach every control. -->
        <ui:VisualElement name="options-view" class="cd-window cd-window--flush cd-dock-center cd-hidden">
            <ui:Label text="Options" class="cd-title" />

            <ui:Label text="Audio" class="cd-subtitle" />
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Master" class="cd-option-label" />
                <ui:Button name="master-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="master-value" text="" class="cd-option-value" />
                <ui:Button name="master-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Music" class="cd-option-label" />
                <ui:Button name="music-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="music-value" text="" class="cd-option-value" />
                <ui:Button name="music-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Sound Effects" class="cd-option-label" />
                <ui:Button name="sfx-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="sfx-value" text="" class="cd-option-value" />
                <ui:Button name="sfx-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>

            <ui:Button name="options-mute" text="" class="cd-menu-button" />
            <ui:Label name="options-note" text="" class="cd-info-label cd-hint" />
            <ui:Button name="options-close" text="Back" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

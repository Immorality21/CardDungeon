/* ============================================================
   Card Dungeon — shared UI Toolkit theme
   Reusable across every screen. Flat-color, flexbox layout
   (no fragile RectTransform anchor math). Swap the colors here
   and every screen updates.
   ============================================================ */

:root, .sg-scope {
    --cd-overlay: rgba(12, 9, 26, 0.85);
    --cd-parchment: rgb(216, 198, 154);
    --cd-frame: rgb(58, 42, 22);
    --cd-stone: rgb(107, 100, 134);
    --cd-stone-hover: rgb(135, 128, 165);
    --cd-stone-disabled: rgb(74, 70, 92);
    --cd-text-dark: rgb(46, 31, 16);
    --cd-text-light: rgb(242, 224, 184);
    --cd-accent: rgb(128, 204, 255);
}

/* Full-screen transparent host; children position themselves. */
.cd-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

/* Compact command window, anchored toward the bottom (FFVIII-style). */
.cd-window {
    width: 620px;
    max-width: 92%;
    max-height: 62%;
    margin-bottom: 8%;
    padding: 14px 16px 16px 16px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

.cd-title {
    -unity-font-style: bold;
    font-size: 22px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* Scrollable list body — grows to fill, scrolls when overflowing. */
.cd-list {
    flex-grow: 1;
    min-height: 120px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px;
}

/* One row (magic slot, draw option, or target). A clickable button. */
.cd-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin: 3px 0;
    padding: 0 10px;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
    color: var(--cd-text-light);
}

.cd-row:hover {
    background-color: var(--cd-stone-hover);
}

.cd-row:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-row__icon {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-row__name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: var(--cd-text-light);
}

.cd-row__meta {
    flex-shrink: 0;
    width: 96px;
    font-size: 15px;
    -unity-text-align: middle-right;
    color: var(--cd-text-light);
}

/* Standard stone button (Back, actions, menu buttons). */
.cd-button {
    height: 46px;
    margin-top: 10px;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* A narrower button centered in its row (e.g. Back). */
.cd-button--narrow {
    width: 45%;
    align-self: center;
}

/* ---- Docking (absolute overlays inside .cd-root) ----
   Center the docked element by translating it, rather than stretching it with
   left/right:0 — stretching forces full width and overrides the element's own
   child alignment (which broke the command-window header and off-set dialogs). */
.cd-dock-bottom {
    position: absolute;
    bottom: 42px;
    left: 50%;
    translate: -50% 0;
}

.cd-dock-center {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

/* FF-style two-corner combat HUD: status bottom-left, command box bottom-right. */
.cd-dock-bottom-left {
    position: absolute;
    bottom: 42px;
    left: 24px;
}

.cd-dock-bottom-right {
    position: absolute;
    bottom: 42px;
    right: 24px;
}

/* Compact target/slot picker docked into the command-box corner during combat.
   Padding 0 + overflow hidden so the dark header bar sits flush like the command window. */
.cd-window--combat {
    width: 380px;
    max-width: 42%;
    max-height: 54%;
    margin-bottom: 0;
    padding: 0 0 8px 0;
    overflow: hidden;
}

/* ---- Party status window (hero names + HP) ---- */
.cd-party-status {
    min-width: 220px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-party-status__header {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--cd-text-light);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 7px 10px;
}

.cd-party-status__rows {
    padding: 8px 10px;
}

.cd-party-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    margin: 2px 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-party-row__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-party-row__hp {
    font-size: 15px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 18px;
}

.cd-party-row--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-party-row--dead {
    opacity: 0.45;
}

.cd-dock-top-right {
    position: absolute;
    top: 24px;
    right: 24px;
}

/* ---- Command menu: cursor-driven vertical selection list (FFX-style) ---- */
.cd-command-list {
    padding: 8px 10px 10px 8px;
    min-width: 200px;
}

.cd-cmd-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 10px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-cmd-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.cd-cmd-row--selected {
    background-color: rgba(128, 204, 255, 0.32);
    border-color: var(--cd-frame);
}

.cd-cmd-row--disabled {
    opacity: 0.4;
}

.cd-cmd-row__cursor {
    width: 22px;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-cmd-row__label {
    flex-grow: 1;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

/* ---- Turn-order list (FFX-style vertical column, top-right) ---- */
.cd-turn-order {
    width: 132px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-turn-order__header {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--cd-text-light);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 5px 8px;
}

.cd-turn-order__list {
    padding: 6px;
}

.cd-turn-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin: 2px 0;
    padding: 0 6px;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-turn-row--current {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-turn-row__icon {
    width: 26px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--cd-frame);
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-turn-row__name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Combat selection lists (magic slots / targets) — matches the command menu ---- */
.cd-select-scroll {
    flex-grow: 1;
    min-height: 60px;
    max-height: 300px;
    padding: 4px 2px;
}

.cd-sel-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 2px 0;
    padding: 0 8px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-sel-row:hover {
    background-color: rgba(128, 204, 255, 0.32);
    border-color: var(--cd-frame);
}

.cd-sel-row--selected {
    background-color: rgba(128, 204, 255, 0.32);
    border-color: var(--cd-frame);
}

.cd-sel-row:disabled {
    opacity: 0.4;
}

.cd-sel-row__cursor {
    width: 20px;
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-sel-row__icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-sel-row__name {
    flex-grow: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

.cd-sel-row__meta {
    flex-shrink: 0;
    font-size: 14px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 10px;
}

/* ---- Simple bottom command bar (Examine/Action, Fight/Flee) ---- */
.cd-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

/* A command button used in bars and the hero command window. */
.cd-cmd {
    min-width: 120px;
    height: 46px;
    margin: 0 5px;
    padding: 0 16px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cmd:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cmd:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* ---- Hero command window (turn header + action row) ---- */
.cd-command-window {
    min-width: 560px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-command-window__header {
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 9px 12px;
}

.cd-command-window__row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px;
}

/* ---- Dialog message body (results, death, examine detail) ---- */
.cd-message {
    white-space: normal;
    font-size: 17px;
    color: var(--cd-text-dark);
    -unity-text-align: upper-left;
    min-height: 60px;
    margin-bottom: 10px;
}

/* Detail-window button row. One button centres; two sit side by side, so a question always has
   a visible way to decline it. */
.cd-detail-buttons {
    flex-direction: row;
    justify-content: center;
}

.cd-detail-buttons > .cd-button--wide {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 45%;
    margin-left: 6px;
    margin-right: 6px;
}

/* Content-sized variant of .cd-list. Use inside .cd-window (which does not clip): a flex-grow
   scroll view spills its content container past its own box and swallows clicks on the buttons
   below it. */
.cd-list--fit {
    flex-grow: 0;
    min-height: 0;
    max-height: 260px;
}

/* The room-event odds line. Set apart from the prompt: it is the mechanical read on the gamble,
   not part of the fiction. */
.cd-event-odds {
    white-space: normal;
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* Full-width text button used for option lists (Examine/Action results). */
.cd-list-button {
    height: 44px;
    margin: 3px 0;
    -unity-font-style: bold;
    font-size: 17px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-list-button:hover {
    background-color: var(--cd-stone-hover);
}

/* ============================================================
   Main menu
   ============================================================ */

/* Opaque full-screen backdrop for the menu scene. */
.cd-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(20, 16, 40);
}

/* A window that centers cleanly (no lower-bias margin). */
.cd-window--flush {
    margin-bottom: 0;
}

/* Fixed-height window: for views whose content changes size between states (e.g. the inventory
   hiding its hero row/stats per tab). A constant height keeps the translate-centered window from
   re-centering, which otherwise desyncs UITK's input hit-testing from the render (clicks miss). */
.cd-window--fixed {
    height: 62%;
}

.cd-title--large {
    font-size: 34px;
    margin-bottom: 18px;
}

.cd-info-label {
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.cd-feedback {
    color: var(--cd-text-dark);
    font-size: 15px;
    -unity-text-align: middle-center;
    min-height: 20px;
    margin-top: 6px;
}

/* Compact keyboard-controls hint line (e.g. under the inventory list).
   margin-top: auto absorbs the fixed-height window's free space, anchoring the hint + the Back
   button beneath it to the bottom so they don't jump as the list content changes size. */
.cd-hint {
    font-size: 12px;
    opacity: 0.7;
    margin-top: auto;
    margin-bottom: 2px;
}

/* Hub inventory list. Unlike the combat picker (cd-select-scroll), this lives in a NON-clipping
   menu window, so it must NOT flex-grow: a stretched ScrollView content container would spill over
   and swallow clicks meant for the Back button below it. Content-sized, capped, transparent so the
   dark row text stays readable on parchment. */
.cd-inv-scroll {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 40px;
    max-height: 320px;
    padding: 4px 2px;
}

/* Tall stacked menu button (full window width). */
.cd-menu-button {
    height: 54px;
    margin: 6px 0;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 20px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-menu-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-menu-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-currency-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.cd-currency-row > Label {
    margin: 0 12px;
    color: var(--cd-text-dark);
    font-size: 16px;
    -unity-font-style: bold;
}

.cd-button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

/* ---- Forge: tabs ---- */
.cd-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.cd-tab {
    padding: 6px 20px;
    margin: 0 4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-tab:hover {
    background-color: var(--cd-stone-hover);
}

.cd-tab--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

/* ---- Forge: collection grid ---- */
.cd-grid-scroll {
    flex-grow: 1;
    min-height: 220px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px;
}

/* Make the scroll view's content lay cells out in a wrapping grid. */
.cd-grid-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.cd-cell {
    width: 68px;
    height: 68px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cell:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cell--locked {
    background-color: var(--cd-stone-disabled);
}

.cd-cell__icon {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-cell__q {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
}

/* ---- Forge: inspect panel ---- */
.cd-inspect {
    flex-grow: 1;
}

.cd-inspect__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cd-inspect__icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: var(--cd-stone);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inspect__titlecol {
    flex-grow: 1;
}

.cd-inspect__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__level {
    font-size: 14px;
    color: var(--cd-text-dark);
}

.cd-inspect__desc {
    white-space: normal;
    font-size: 14px;
    color: var(--cd-text-dark);
    margin-bottom: 8px;
}

.cd-inspect__effects {
    margin-bottom: 8px;
}

.cd-effect-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 6px;
    margin: 2px 0;
    background-color: rgba(41, 31, 20, 0.22);
    border-radius: 3px;
}

.cd-effect-row--locked {
    opacity: 0.5;
}

.cd-effect-row__text {
    font-size: 13px;
    color: var(--cd-text-dark);
}

.cd-effect-row__lock {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.cd-inspect__actions > .cd-button--narrow {
    margin-right: 8px;
}

/* ---- Victory summary (shown over the battle stage) ---- */
.cd-victory {
    width: 440px;
    max-width: 90%;
    padding: 0 0 16px 0;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 10px;
    overflow: hidden;
    align-items: center;
}

.cd-victory__title {
    width: 100%;
    -unity-font-style: bold;
    font-size: 30px;
    color: var(--cd-text-light);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 12px 0;
    margin-bottom: 12px;
}

.cd-victory__rewards {
    width: 100%;
    padding: 0 26px;
    margin-bottom: 10px;
}

.cd-victory-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 9px 4px;
    margin: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-victory-row__label {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-victory-row__value {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
}

.cd-victory-loot {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px 3px 16px;
}

.cd-victory-loot__icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-victory-loot__name {
    font-size: 15px;
    color: var(--cd-text-dark);
}

/* Boss encounter banner — top-center, announces the climax fight. */
.cd-boss-banner {
    position: absolute;
    top: 48px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    padding: 10px 34px;
    background-color: rgba(40, 8, 10, 0.9);
    border-width: 2px;
    border-color: rgb(150, 40, 40);
    border-radius: 6px;
}

.cd-boss-banner__sub {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(224, 120, 110);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.cd-boss-banner__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
}

/* Merchant gear shop (buy/sell rows). */
.cd-subtitle {
    -unity-font-style: bold;
    font-size: 15px;
    color: var(--cd-text-dark);
    margin-top: 10px;
    margin-bottom: 2px;
}

.cd-shop-list {
    max-height: 150px;
    margin-bottom: 2px;
}

.cd-shop-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    margin: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-shop-row__icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-shop-row__name {
    flex-grow: 1;
    font-size: 14px;
    color: var(--cd-text-dark);
}

.cd-shop-row__sub {
    font-size: 11px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    opacity: 0.75;
    white-space: normal;
}

.cd-shop-row__btn {
    flex-shrink: 0;
    min-width: 96px;
}

/* Party select: a left accent bar so fielded and benched rows are distinguishable
   without reading the button. */
.cd-party-row--fielded {
    border-left-width: 3px;
    border-left-color: var(--cd-frame);
    padding-left: 5px;
}

.cd-party-row--benched {
    opacity: 0.72;
}

.cd-shop-empty {
    font-size: 13px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    padding: 6px 4px;
}

/* Utility: hidden (controller toggles this). */
.cd-hidden {
    display: none;
}

/* ============================================================
   Sphere grid — shared graph view (hub screen + editor window)
   ============================================================ */

/* A wider window: the pannable graph plus its detail panel need more than 620px. */
.cd-window--wide {
    width: 1140px;
}

/* The graph viewport. overflow:hidden clips the pannable content, so nothing can spill
   out and swallow clicks meant for the buttons beneath it (the ScrollView trap). */
.sg-viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(41, 31, 20, 0.35);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* The panned/zoomed content plane. transform-origin must be the top-left corner:
   UITK's default is 50% 50%, which makes scaling orbit the element's center and
   desyncs the zoom-toward-cursor math. */
.sg-content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: left top;
}

.sg-node {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: var(--cd-frame);
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone-disabled);
    margin: 0;
    padding: 0;
}

.sg-node:hover {
    border-color: var(--cd-accent);
}

/* Activation states (SphereGridPresenter.StateClass drives these). */
.sg-node--activated {
    background-color: var(--cd-accent);
}

.sg-node--available {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.sg-node--adjacent {
    background-color: var(--cd-stone);
}

.sg-node--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.45;
}

.sg-node--selected {
    border-color: var(--cd-text-light);
    scale: 1.15;
}

/* Editor connect-mode source highlight. */
.sg-node--source {
    border-color: var(--cd-parchment);
}

/* Kind accents. */
.sg-node--start {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    border-width: 4px;
}

.sg-node__glyph {
    color: var(--cd-text-light);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.sg-node--activated .sg-node__glyph {
    color: var(--cd-text-dark);
}

/* Screen layout: graph on the left, always-present detail panel on the right, so the
   window's size never changes between states (the dock-center hit-test trap). */
.sg-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
}

.sg-detail {
    width: 300px;
    flex-shrink: 0;
    margin-left: 10px;
    padding: 10px;
    background-color: rgba(58, 42, 22, 0.12);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* ============================================================
   Card Dungeon — shared UI Toolkit theme
   Reusable across every screen. Flat-color, flexbox layout
   (no fragile RectTransform anchor math). Swap the colors here
   and every screen updates.
   ============================================================ */

/* Readability floor (playtest 2026-09-28, finding 12): no text in this sheet is set below 16px.
   Every panel scales from its reference resolution, so at 1280x720 a size here renders at about
   two thirds - 16px is roughly the smallest that still reads there. Hint lines and "meta" text were
   12-15px and came out at 8-10. Exempt: .dm-glyph, sized to fit the floor map's room boxes. */
:root, .sg-scope {
    --cd-overlay: rgba(6, 3, 14, 0.92);
    --cd-parchment: rgb(14, 7, 28);
    --cd-frame: rgb(91, 42, 145);
    --cd-stone: rgb(35, 18, 58);
    --cd-stone-hover: rgb(104, 47, 165);
    --cd-accent: rgb(205, 110, 255);
    --cd-gold: rgb(236, 190, 72);

    --cd-text-dark: rgb(245, 240, 255);
    --cd-text-light: rgb(245, 240, 255);

    --cd-stone-disabled: rgb(26, 17, 38);

    /* A recessed panel inside a window: a list, a detail page, a scroll body. The inventory
       column's look, so every screen's wells match the bar the Storehouse set. */
    --cd-well: rgba(0, 0, 0, 0.30);
    --cd-well-soft: rgba(0, 0, 0, 0.20);
    --cd-well-border: rgba(205, 110, 255, 0.22);
}

/* Full-screen transparent host; children position themselves. */
.cd-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    /* The base every label inherits. UI Toolkit's own default is 12px, which the 1920x1080
       reference scale turns into 8px at 1280x720 - any label without a class of its own used to
       land there (playtest 2026-09-28, finding 12). */
    font-size: 18px;
}

/* Compact command window, anchored toward the bottom (FFVIII-style). */
.cd-window {
    width: 620px;
    max-width: 92%;
    max-height: 62%;
    margin-bottom: 8%;
    padding: 14px 16px 16px 16px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

.cd-title {
    -unity-font-style: bold;
    font-size: 22px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* Scrollable list body — grows to fill, scrolls when overflowing. */
.cd-list {
    flex-grow: 1;
    min-height: 120px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 4px;
    padding: 6px;
}

/* One row (magic slot, draw option, or target). A clickable button. */
.cd-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin: 3px 0;
    padding: 0 10px;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
    color: var(--cd-text-light);
}

.cd-row:hover {
    background-color: var(--cd-stone-hover);
}

.cd-row:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-row__icon {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-row__name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: var(--cd-text-light);
}

.cd-row__meta {
    flex-shrink: 0;
    width: 96px;
    font-size: 16px;
    -unity-text-align: middle-right;
    color: var(--cd-text-light);
}

/* Standard stone button (Back, actions, menu buttons). */
.cd-button {
    height: 46px;
    margin-top: 10px;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* A narrower button centered in its row (e.g. Back). */
.cd-button--narrow {
    width: 45%;
    align-self: center;
}

/* ---- Docking (absolute overlays inside .cd-root) ----
   Center the docked element by translating it, rather than stretching it with
   left/right:0 — stretching forces full width and overrides the element's own
   child alignment (which broke the command-window header and off-set dialogs). */
.cd-dock-bottom {
    position: absolute;
    bottom: 42px;
    left: 50%;
    translate: -50% 0;
}

.cd-dock-center {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

/* FF-style two-corner combat HUD: the command menu (and the pickers that replace it) in the
   bottom-left corner, party status bottom-right. Tight to the corner, so the menu covers as
   little of the stage above it as possible - the heroes stand just over it. */
.cd-dock-bottom-left {
    position: absolute;
    bottom: 16px;
    left: 16px;
}

.cd-dock-bottom-right {
    position: absolute;
    bottom: 16px;
    right: 16px;
}

/* Compact target/slot picker docked into the command-box corner during combat.
   Padding 0 + overflow hidden so the dark header bar sits flush like the command window. */
.cd-window--combat {
    width: 380px;
    max-width: 42%;
    max-height: 54%;
    margin-bottom: 0;
    padding: 0 0 8px 0;
    overflow: hidden;
}

/* The ability / item / target pickers: wider than the command menu, so an ability's description
   wraps to fewer lines and the window stays low. Its height is what matters - the heroes stand
   in a column right above the bottom-left dock, and a tall picker covers the one whose turn it is. */
.cd-window--picker {
    width: 640px;
    max-width: 52%;
    max-height: 40%;
}

/* List and description side by side, so the picker stays as low as the command menu. */
.cd-picker-body {
    flex-direction: row;
    flex-shrink: 1;
    min-height: 0;
}

/* Doubled so it beats .cd-select-scroll's flex-grow, which otherwise hands the list the width. */
.cd-select-scroll.cd-picker-list {
    width: 280px;
    flex-grow: 0;
    flex-shrink: 0;
}

.cd-sel-desc.cd-picker-desc {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 4px 10px 4px 4px;
    border-top-width: 0;
    border-left-width: 1px;
    border-left-color: var(--cd-frame);
}

/* ---- Party status window (hero names + HP) ----
   Sized like the command menu opposite it (2026-09-29): compact rows, tight to its corner. */
.cd-party-status {
    min-width: 200px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-party-status__header {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--cd-gold);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 6px 10px;
}

.cd-party-status__rows {
    padding: 4px 6px 6px 6px;
}

.cd-party-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    margin: 1px 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-party-row__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-party-row__hp {
    font-size: 16px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 14px;
}

.cd-party-row--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-party-row--dead {
    opacity: 0.45;
}

.cd-dock-top-right {
    position: absolute;
    top: 24px;
    right: 24px;
}

.cd-dock-top-left {
    position: absolute;
    top: 24px;
    left: 24px;
}

/* ---- Dungeon HUD: where you are and what the floor has paid so far ---- */
.cd-hud {
    padding: 10px 16px 12px 16px;
    background-color: rgba(14, 7, 28, 0.88);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 10px;
    max-width: 46%;
}

.cd-hud__level {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    margin: 0;
    padding: 0;
}

.cd-hud__run {
    font-size: 18px;
    color: var(--cd-text-light);
    margin: 2px 0 6px 0;
    padding: 0;
}

.cd-hud__gold {
    font-size: 18px;
    color: var(--cd-gold);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.cd-hud__explore {
    font-size: 17px;
    color: rgb(200, 190, 225);
    margin: 4px 0 0 0;
    padding: 0;
    white-space: normal;
}

/* ---- Command menu: cursor-driven vertical selection list (FFX-style) ---- */
.cd-command-list {
    padding: 4px 6px 6px 4px;
    min-width: 170px;
}

.cd-cmd-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 10px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-cmd-row:hover {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-cmd-row--selected {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-cmd-row--disabled {
    opacity: 0.4;
}

.cd-cmd-row__cursor {
    width: 18px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-cmd-row__label {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

/* Why a greyed command is greyed ("No charges", "Silenced"). The row is already at 40%, so this
   is italic rather than dimmer again. */
.cd-cmd-row__reason {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
}

/* ---- Turn-order list (FFX-style vertical column, top-right) ---- */
/* The turn order is a column of portraits, FFX-style (2026-09-30): no names and no header.
   Names were cut off at 180px ("Abyssal Warde") and the width put the panel over a boss.
   Frame colour says the side (purple = party, red = enemy), and the actor's tile is the big one. */
.cd-turn-order {
    width: 64px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    /* Visible, so the acting unit's tile can pop out of the column to the left (FFX's offset). */
    overflow: visible;
}

/* Tucked 8px from the right edge, like the party panel below it. */
.cd-party-status.cd-dock-bottom-right {
    right: 8px;
}

.cd-turn-order.cd-dock-top-right {
    right: 8px;
}

.cd-turn-order__list {
    padding: 5px 4px;
    align-items: center;
}

.cd-turn-row {
    width: 46px;
    height: 46px;
    margin: 2px 0;
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: rgb(120, 70, 180);
    border-radius: 6px;
}

.cd-turn-row--enemy {
    border-color: rgb(200, 70, 70);
    background-color: rgb(48, 18, 26);
}

.cd-turn-row__icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- Combat selection lists (magic slots / targets) — matches the command menu ---- */
.cd-select-scroll {
    flex-grow: 1;
    min-height: 60px;
    max-height: 300px;
    padding: 4px 2px;
}

.cd-sel-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 2px 0;
    padding: 0 8px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-sel-row:hover {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-sel-row--selected {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-sel-row:disabled {
    opacity: 0.4;
}

.cd-sel-row__cursor {
    width: 20px;
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-sel-row__icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-sel-row__name {
    flex-grow: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

.cd-sel-row__meta {
    flex-shrink: 0;
    font-size: 16px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 10px;
}

/* ---- Enemy nameplates (combat): name + HP number under each enemy ---- */
/* ---- Dungeon walking HUD and room dialogs, 2026-09-30 ---- */
/* The HUD keeps one width, so it no longer grows and shrinks with its text over the room. */
.cd-hud {
    width: 360px;
}

/* Who is in the room, hung above the Fight / Flee bar. */
.cd-bar__foes {
    position: absolute;
    bottom: 100%;
    left: -200px;
    right: -200px;
    margin-bottom: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.cd-dialog-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 3, 14, 0.55);
}

/* An event choice: its words on the left (wrapping), its tag on the right, never overlapping. */
.cd-list-button.cd-event-option {
    flex-direction: row;
    align-items: center;
    height: auto;
    min-height: 44px;
    padding: 6px 12px;
}

.cd-event-option__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-left;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0 12px 0 0;
}

/* An event choice's tag on the right: what governs it and how the odds read, or "safe". */
.cd-event-tag {
    flex-shrink: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    padding: 0;
    margin: 0;
}

.cd-event-tag--safe {
    color: rgb(150, 230, 150);
}

.cd-event-tag--good {
    color: rgb(150, 230, 150);
}

.cd-event-tag--even {
    color: var(--cd-gold);
}

.cd-event-tag--bad {
    color: rgb(255, 130, 120);
}

.cd-event-tag--unknown {
    color: var(--cd-text-light);
    opacity: 0.6;
}

/* Success / Failed over an event result. */
.cd-detail-chip {
    align-self: center;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 2px 12px;
    margin: 0 0 8px 0;
    border-radius: 5px;
    border-width: 1px;
}

.cd-detail-chip--good {
    color: rgb(150, 230, 150);
    border-color: rgb(90, 170, 90);
    background-color: rgba(40, 110, 50, 0.35);
}

.cd-detail-chip--bad {
    color: rgb(255, 140, 130);
    border-color: rgb(180, 70, 70);
    background-color: rgba(120, 30, 30, 0.35);
}

.cd-detail-rows {
    margin: 4px 0 10px 0;
}

/* The party window: portrait, name, a slim HP bar, and any level affliction as a chip. */
.cd-party-row__portrait {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-party-row__main {
    flex-grow: 1;
    min-width: 0;
}

.cd-party-row__top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cd-party-row__bar {
    height: 5px;
    margin-top: 2px;
    background-color: rgb(16, 12, 24);
    border-radius: 2px;
}

.cd-party-row__fill {
    height: 100%;
    background-color: rgb(60, 175, 80);
    border-radius: 2px;
}

.cd-party-row__fill--mid {
    background-color: rgb(200, 160, 40);
}

.cd-party-row__fill--low {
    background-color: rgb(200, 60, 60);
}

/* The Ultra gauge (COMBAT_DEPTH §13), under the health bar for a hero who knows an Ultra. */
.cd-party-row__gauge {
    height: 3px;
    margin-top: 2px;
    background-color: rgb(16, 12, 24);
    border-radius: 1px;
}

.cd-party-row__gauge-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(150, 90, 210);
    border-radius: 1px;
}

.cd-party-row__gauge-fill--full {
    background-color: rgb(245, 200, 80);
}

.cd-party-row__gauge-fill--active {
    background-color: rgb(220, 60, 90);
}

.cd-party-row__afflictions {
    flex-direction: row;
    flex-wrap: wrap;
}

.cd-party-row__affliction {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 150, 140);
    padding: 0 4px;
    margin: 2px 4px 0 0;
    border-width: 1px;
    border-color: rgba(200, 80, 80, 0.7);
    border-radius: 3px;
}

.cd-nameplate-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cd-nameplate {
    align-items: center;
    padding: 1px 6px;
    background-color: rgba(6, 3, 14, 0.72);
    border-radius: 3px;
}

.cd-nameplate__name {
    font-size: 16px;
    color: var(--cd-text-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* The HP number, drawn over the bar's fill. White with a dark outline so it reads on green,
   yellow, red and the empty track alike. */
.cd-nameplate__hp {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(10, 6, 18);
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.cd-nameplate__hp--low {
    color: rgb(255, 200, 195);
}

/* The enemy's HP bar lives in its plate (2026-09-30): one readout per unit, under its feet. The
   floating world bar above the head sat nearer the unit above it than its own, and doubled the
   plate's number. The low colour matches the number's. */
.cd-nameplate__bar {
    width: 88px;
    height: 21px;
    margin: 2px 0 2px 0;
    background-color: rgb(16, 12, 24);
    border-width: 1px;
    border-color: rgba(217, 204, 242, 0.75);
    border-radius: 2px;
}

/* Deep fills, so the white number on top stays readable at every level. */
.cd-nameplate__fill {
    height: 100%;
    background-color: rgb(38, 140, 62);
}

.cd-nameplate__fill--mid {
    background-color: rgb(166, 124, 20);
}

.cd-nameplate__fill--low {
    background-color: rgb(170, 40, 40);
}

.cd-nameplate--boss .cd-nameplate__bar {
    width: 170px;
    height: 24px;
    background-color: rgb(46, 10, 13);
}

/* A hero's plate is the bar alone - the party panel already names them. */
.cd-nameplate--hero .cd-nameplate__name {
    display: none;
}

.cd-nameplate--hero {
    padding: 2px 3px;
}

.cd-nameplate--boss .cd-nameplate__name {
    font-size: 19px;
    color: var(--cd-gold);
}

/* Footer under a picker list: what the selected ability/item does. Wraps, because the mechanics
   line ("One enemy: 9 damage (Attack 7) · Bleeding 1/turn, 3 turns") is longer than the window. */
.cd-sel-desc {
    white-space: normal;
    font-size: 16px;
    color: var(--cd-text-light);
    margin: 2px 12px 8px 12px;
    padding: 6px 8px;
    border-top-width: 1px;
    border-top-color: var(--cd-frame);
}

/* ---- Simple bottom command bar (Examine/Action, Fight/Flee) ---- */
.cd-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

/* A command button used in bars and the hero command window. */
.cd-cmd {
    min-width: 120px;
    height: 46px;
    margin: 0 5px;
    padding: 0 16px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cmd:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cmd:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* ---- Hero command window (turn header + action row) ---- */
/* Sized by its rows, not a fixed width: it is a vertical list since the command row became a
   cursor menu, and the 560px it kept from the old horizontal button row was mostly empty frame. */
.cd-command-window {
    min-width: 190px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-command-window__header {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--cd-gold);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 6px 10px;
}

.cd-command-window__row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px;
}

/* ---- Dialog message body (results, death, examine detail) ---- */
.cd-message {
    white-space: normal;
    font-size: 17px;
    color: var(--cd-text-dark);
    -unity-text-align: upper-left;
    min-height: 60px;
    margin-bottom: 10px;
}

/* Detail-window button row. One button centres; two sit side by side, so a question always has
   a visible way to decline it. */
.cd-detail-buttons {
    flex-direction: row;
    justify-content: center;
}

.cd-detail-buttons > .cd-button--wide {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 45%;
    margin-left: 6px;
    margin-right: 6px;
}

/* Content-sized variant of .cd-list. Use inside .cd-window (which does not clip): a flex-grow
   scroll view spills its content container past its own box and swallows clicks on the buttons
   below it. */
.cd-list--fit {
    flex-grow: 0;
    min-height: 0;
    max-height: 260px;
}

/* The room-event odds line. Set apart from the prompt: it is the mechanical read on the gamble,
   not part of the fiction. */
.cd-event-odds {
    white-space: normal;
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* Full-width text button used for option lists (Examine/Action results). */
.cd-list-button {
    height: 44px;
    margin: 3px 0;
    -unity-font-style: bold;
    font-size: 17px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-list-button:hover {
    background-color: var(--cd-stone-hover);
}

/* ============================================================
   Main menu
   ============================================================ */

/* Opaque full-screen backdrop for the menu scene. */
.cd-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(20, 16, 40);
    -unity-background-scale-mode: scale-and-crop;
}

/* Painted backdrops behind the menus that used to float on flat colour (playtest finding 14,
   POLISH_CONTENT 21). Dimmed by the tint so the panel in front stays the thing you read. The title
   sets its class in MainMenu.uxml; the hub switches between the other two in HubManager. */
.cd-bg--title {
    background-image: url("project://database/Assets/UI/Backdrops/title.png");
    -unity-background-image-tint-color: rgb(190, 180, 210);
}

.cd-bg--level-entry {
    background-image: url("project://database/Assets/UI/Backdrops/level_entry.png");
    -unity-background-image-tint-color: rgb(170, 160, 190);
}

.cd-bg--story-map {
    background-image: url("project://database/Assets/UI/Backdrops/story_map.png");
    -unity-background-image-tint-color: rgb(170, 160, 190);
}

/* A window that centers cleanly (no lower-bias margin). */
.cd-window--flush {
    margin-bottom: 0;
}

/* Fixed-height window: for views whose content changes size between states (e.g. the inventory
   hiding its hero row/stats per tab). A constant height keeps the translate-centered window from
   re-centering, which otherwise desyncs UITK's input hit-testing from the render (clicks miss). */
.cd-window--fixed {
    height: 62%;
}

.cd-title--large {
    font-size: 34px;
    margin-bottom: 18px;
}

.cd-info-label {
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.cd-feedback {
    color: var(--cd-text-dark);
    font-size: 16px;
    -unity-text-align: middle-center;
    min-height: 20px;
    margin-top: 6px;
}

/* Compact keyboard-controls hint line (e.g. under the inventory list).
   margin-top: auto absorbs the fixed-height window's free space, anchoring the hint + the Back
   button beneath it to the bottom so they don't jump as the list content changes size. */
.cd-hint {
    font-size: 16px;
    opacity: 0.7;
    margin-top: auto;
    margin-bottom: 2px;
}

/* ============================================================
   Hub inventory - one fixed frame for all four tabs (redesigned 2026-09-28)
   Header band with the tabs, a hero strip, three fixed columns and a hint line.
   Every region is sized in px and present on every tab, so the dock-centred
   window never changes size: it used to shrink its tab rows to 12px and move
   them 45px between tabs, and a resized centred window desyncs hit-testing.
   ============================================================ */

.cd-inv-window {
    width: 1180px;
    height: 720px;
    max-width: 98%;
    max-height: none;
    padding: 0;
    overflow: hidden;
    flex-direction: column;
}

.cd-inv-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 58px;
    padding: 0 14px 0 20px;
    background-color: rgb(67, 30, 108);
    border-bottom-width: 1px;
    border-bottom-color: var(--cd-accent);
}

.cd-inv-header__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    margin-right: 28px;
}

.cd-inv-tabs {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
}

.cd-inv-tab,
.cd-inv-close {
    height: 38px;
    margin: 0 6px 0 0;
    padding: 0 18px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    background-color: rgba(14, 7, 28, 0.6);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

.cd-inv-tab:hover,
.cd-inv-close:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

.cd-inv-tab--active,
.cd-inv-tab--active:hover {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-accent);
}

.cd-inv-close {
    margin: 0;
}

/* The hero strip: a portrait card per owned hero. Muted, not hidden, on the party-wide tabs -
   hiding it is what used to make the window jump between tabs. */
.cd-inv-heroes {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 116px;
    padding: 0 20px;
    background-color: rgba(0, 0, 0, 0.28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.18);
}

/* A party-wide tab (Materials, Consumables): the strip keeps its height so nothing below moves,
   but the cards read as "not applicable" - faint, frameless, no card behind them - rather than as
   four disabled buttons. The doubled selector beats .cd-inv-hero:hover further down. */
.cd-inv-heroes--muted .cd-inv-hero,
.cd-inv-heroes--muted .cd-inv-hero:hover {
    opacity: 0.35;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* The right end of the strip: the selected hero at a glance, or the purse. */
.cd-inv-heroes__summary {
    margin-left: auto;
    align-items: flex-end;
    justify-content: center;
}

.cd-inv-heroes__summary-line {
    font-size: 18px;
    color: var(--cd-text-light);
    opacity: 0.8;
    -unity-text-align: middle-right;
    padding: 0;
    margin: 1px 0;
}

.cd-inv-heroes__summary-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    opacity: 1;
}

.cd-inv-hero {
    width: 124px;
    height: 96px;
    margin-right: 12px;
    padding: 4px 4px 6px 4px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(35, 18, 58, 0.6);
    border-width: 2px;
    border-color: rgba(91, 42, 145, 0.7);
    border-radius: 8px;
}

.cd-inv-hero:hover {
    border-color: rgb(156, 82, 210);
}

.cd-inv-hero--active,
.cd-inv-hero--active:hover {
    background-color: rgb(67, 30, 108);
    border-color: var(--cd-accent);
}

/* 32px hero art at exactly 2x, so the pixels stay square. */
.cd-inv-hero__sprite {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inv-hero__name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
}

.cd-inv-hero--active .cd-inv-hero__name {
    color: var(--cd-gold);
}

.cd-inv-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 14px 16px 8px 16px;
}

.cd-inv-col {
    flex-direction: column;
    flex-shrink: 0;
    padding: 10px 12px;
    background-color: rgba(0, 0, 0, 0.32);
    border-width: 1px;
    border-color: rgba(205, 110, 255, 0.22);
    border-radius: 8px;
    overflow: hidden;
}

.cd-inv-col--left {
    width: 340px;
}

.cd-inv-col--list {
    width: 360px;
    margin: 0 14px;
}

.cd-inv-col--detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.cd-inv-col__title {
    flex-shrink: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-accent);
    -unity-text-align: middle-left;
    padding-bottom: 4px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.35);
}

.cd-inv-col__content {
    flex-grow: 1;
}

.cd-inv-list {
    flex-grow: 1;
}

.cd-inv-empty {
    font-size: 17px;
    color: var(--cd-text-light);
    opacity: 0.7;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 24px 12px 0 12px;
}

/* One row: icon tile, a name with a caption under it, and a right-hand note. */
.cd-inv-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 56px;
    margin-bottom: 3px;
    padding: 0 10px 0 4px;
    background-color: rgba(35, 18, 58, 0.55);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.cd-inv-row:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

.cd-inv-row--selected,
.cd-inv-row--selected:hover {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-accent);
}

/* The slot you are choosing for, while the cursor is in the item list beside it. */
.cd-inv-row--held,
.cd-inv-row--held:hover {
    background-color: rgba(102, 48, 158, 0.4);
    border-color: var(--cd-gold);
}

/* Display-only rows (the loadout summary) never light up under the mouse. */
.cd-inv-row--static:hover {
    background-color: rgba(35, 18, 58, 0.55);
    border-color: rgba(0, 0, 0, 0);
}

.cd-inv-row__cursor {
    width: 14px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-gold);
}

/* 32px inner so 16px and 32px item art both scale by a whole number. */
.cd-inv-row__icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 10px;
    background-color: rgba(14, 7, 28, 0.85);
    border-width: 2px;
    border-color: rgba(205, 110, 255, 0.22);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inv-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.cd-inv-row__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    overflow: hidden;
    text-overflow: ellipsis;
}

.cd-inv-row__caption {
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.6;
}

/* Two stacked labels in a 56px row: UITK's default label padding pushed them into the row's
   top and bottom edges, so it is taken out here. */
.cd-inv-row__name,
.cd-inv-row__caption {
    padding: 0;
    margin: 0;
}

/* A glyph standing in for an icon - the "take it off" row. */
.cd-inv-row__glyph {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-accent);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* The up/down chips on a candidate row: its two biggest stat changes. */
.cd-inv-row__chips {
    flex-shrink: 0;
    margin-left: 8px;
    align-items: flex-end;
    justify-content: center;
}

.cd-inv-row__chip {
    font-size: 16px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-right;
}

.cd-inv-row__meta {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    opacity: 0.85;
    -unity-text-align: middle-right;
}

.cd-inv-row--empty .cd-inv-row__name {
    opacity: 0.45;
    -unity-font-style: italic;
}

.cd-inv-row--empty .cd-inv-row__icon {
    border-color: rgba(205, 110, 255, 0.12);
    background-color: rgba(14, 7, 28, 0.4);
}

/* Up / down against what is worn now - the Inspect page's colour language. */
.cd-inv-delta--up {
    color: rgb(255, 217, 102);
    opacity: 1;
}

/* A loss is red (2026-09-30): pale blue read as "different", not "worse". */
.cd-inv-delta--down {
    color: rgb(255, 130, 120);
    opacity: 1;
}

/* Rarity: the name and the icon frame, never the whole row (that fights the purple selection). */
.cd-rarity--common {
    color: var(--cd-text-light);
}

.cd-rarity--uncommon {
    color: rgb(120, 220, 120);
}

.cd-rarity--rare {
    color: rgb(110, 160, 255);
}

.cd-rarity--epic {
    color: rgb(225, 130, 255);
}

.cd-rarity--legendary {
    color: var(--cd-gold);
}

.cd-inv-tile.cd-rarity--uncommon {
    border-color: rgb(120, 220, 120);
}

.cd-inv-tile.cd-rarity--rare {
    border-color: rgb(110, 160, 255);
}

.cd-inv-tile.cd-rarity--epic {
    border-color: rgb(225, 130, 255);
    background-color: rgba(225, 130, 255, 0.14);
}

.cd-inv-tile.cd-rarity--legendary {
    border-color: var(--cd-gold);
    background-color: rgba(236, 190, 72, 0.14);
}

/* Ability slots as pips: filled for each one carried. */
.cd-inv-pips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 2px 0 12px 2px;
}

.cd-inv-pips__label {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    margin-right: 10px;
}

.cd-inv-pip {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    border-width: 2px;
    border-color: var(--cd-accent);
    border-radius: 10px;
}

.cd-inv-pip--filled {
    background-color: var(--cd-accent);
}

/* The detail column: what the cursor is on. */
.cd-inv-detail__head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 10px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.35);
}

/* 32px art at 2x inside the 2px frame. */
.cd-inv-detail__icon {
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    margin-right: 14px;
    background-color: rgba(14, 7, 28, 0.85);
    border-width: 2px;
    border-color: rgba(205, 110, 255, 0.25);
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inv-detail__titles {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.cd-inv-detail__name {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    white-space: normal;
}

/* A rarity class on the detail title: doubled, because .cd-inv-detail__name sets the plain colour
   at the same specificity further down the file and used to win (every name read white). */
.cd-inv-detail__name.cd-rarity--uncommon {
    color: rgb(120, 220, 120);
}

.cd-inv-detail__name.cd-rarity--rare {
    color: rgb(110, 160, 255);
}

.cd-inv-detail__name.cd-rarity--epic {
    color: rgb(225, 130, 255);
}

.cd-inv-detail__name.cd-rarity--legendary {
    color: var(--cd-gold);
}

.cd-inv-detail__sub {
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.7;
    margin-top: 2px;
}

.cd-inv-detail__body {
    flex-grow: 1;
}

.cd-inv-detail__desc {
    font-size: 17px;
    -unity-font-style: italic;
    color: var(--cd-text-light);
    opacity: 0.8;
    white-space: normal;
    margin: 0 2px 8px 2px;
}

.cd-inv-detail__line {
    font-size: 17px;
    color: var(--cd-text-light);
    white-space: normal;
    margin: 2px 4px;
}

/* Instructions and context, not information: quiet, so they never read as a stat change. */
.cd-inv-detail__note {
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-light);
    opacity: 0.55;
    white-space: normal;
    margin: 8px 4px 4px 4px;
}

/* What an item grants, as a wrapping row of chips. */
.cd-inv-grants {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 6px 0;
}

.cd-inv-grant {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    background-color: rgba(102, 48, 158, 0.35);
    border-width: 1px;
    border-color: rgba(205, 110, 255, 0.35);
    border-radius: 5px;
    padding: 1px 8px;
    margin: 0 6px 6px 0;
}

/* Stats as a two-column grid of short names, so all of them fit without scrolling. */
.cd-inv-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 8px 0;
}

/* Three to a row: with an item's flavour line above, two columns ran the resistances off the
   bottom of a pane that does not scroll. */
.cd-inv-stat {
    width: 33.33%;
    height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 0 4px;
}

.cd-inv-stat__label {
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.8;
    padding: 0;
    margin: 0;
}

.cd-inv-stat__value {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0;
}

/* Resistances read "+20% -> +35%", too long for a third: two to a row. */
.cd-inv-stats--wide .cd-inv-stat {
    width: 50%;
}

/* Up/down on a stat value - doubled selector, because .cd-inv-stat__value above sets the plain colour
   at the same specificity and would otherwise win. */
.cd-inv-stat__value.cd-inv-delta--up {
    color: rgb(255, 217, 102);
}

.cd-inv-stat__value.cd-inv-delta--down {
    color: rgb(255, 130, 120);
}

/* The party-wide tabs' summary in the left column. */
.cd-inv-summary__head {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    white-space: normal;
    margin: 4px 4px 8px 4px;
}

.cd-inv-summary__note {
    font-size: 18px;
    color: var(--cd-text-light);
    opacity: 0.7;
    white-space: normal;
    margin: 0 4px;
}

.cd-inv-hint {
    flex-shrink: 0;
    height: 36px;
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.7;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-top-color: rgba(205, 110, 255, 0.15);
}

/* ============================================================
   Campfire - the party screen on the inventory frame (rebuilt 2026-09-30)
   Seats across the top, the roster, the chosen hero, and the XP split.
   Every region is px-sized and present in every state, for the same
   hit-testing reason as the inventory above. Seats and roster rows are
   Buttons so the hub's shared keyboard cursor reaches them.
   ============================================================ */

.cd-camp-header__cap {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-left;
}

.cd-camp-header__gold {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    margin-right: 16px;
}

/* A seat: the inventory's hero card as a Button. Seat 0 leads. */
.cd-camp-seat {
    width: 124px;
    height: 96px;
    margin: 0 12px 0 0;
    padding: 4px 4px 6px 4px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(35, 18, 58, 0.6);
    border-width: 2px;
    border-color: rgba(91, 42, 145, 0.7);
    border-radius: 8px;
}

.cd-camp-seat:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

.cd-camp-seat--active,
.cd-camp-seat--active:hover {
    background-color: rgb(67, 30, 108);
    border-color: var(--cd-accent);
}

/* An empty seat: a frame and nothing in it (UITK has no dashed border). */
.cd-camp-seat--empty,
.cd-camp-seat--empty:hover {
    background-color: rgba(0, 0, 0, 0.18);
    border-color: rgba(205, 110, 255, 0.16);
    justify-content: center;
}

.cd-camp-seat__sprite {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-camp-seat__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.cd-camp-seat--active .cd-camp-seat__name {
    color: var(--cd-gold);
}

.cd-camp-seat--empty .cd-camp-seat__name {
    -unity-font-style: italic;
    opacity: 0.45;
}

/* The leader's mark: a tab sitting on the seat's top border, clear of the portrait. */
.cd-camp-seat__lead {
    position: absolute;
    top: -12px;
    align-self: center;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    background-color: rgb(67, 30, 108);
    border-width: 1px;
    border-color: var(--cd-gold);
    border-radius: 5px;
    padding: 0 6px;
    margin: 0;
}

.cd-camp-seat--lead {
    border-color: var(--cd-gold);
}

.cd-camp-col--roster {
    width: 330px;
}

.cd-camp-col--detail {
    margin: 0 14px;
}

.cd-camp-col--split {
    width: 300px;
}

/* A roster row is the inventory row as a Button: marching heroes carry a gold accent bar. */
.cd-camp-row {
    -unity-text-align: middle-left;
    margin: 0 0 3px 0;
}

.cd-camp-row--fielded,
.cd-camp-row--fielded:hover {
    border-left-color: var(--cd-gold);
    border-left-width: 4px;
}

/* The caption gives way to the right-hand tag rather than running under it. */
.cd-camp-row .cd-inv-row__caption {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The name and its Leads / Resting tag on one line, so the caption under them has the full width. */
.cd-camp-row__top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cd-camp-row__top .cd-inv-row__name {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cd-camp-row__top .cd-inv-row__meta {
    font-size: 15px;
    padding: 0;
}

.cd-camp-row--benched .cd-inv-row__icon,
.cd-camp-row--benched .cd-inv-row__name {
    opacity: 0.6;
}

.cd-camp-row--fielded .cd-inv-row__meta {
    color: var(--cd-gold);
}

.cd-camp-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin: 2px 0 4px 0;
}

.cd-camp-action {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px 0 0;
}

/* Why the action above is dimmed: always present, so the column never moves. */
.cd-reason {
    flex-shrink: 0;
    height: 24px;
    font-size: 16px;
    -unity-font-style: italic;
    color: rgb(255, 150, 140);
    padding: 0 2px;
    margin: 0 0 6px 0;
}

/* A reason that is a rule rather than a fault (the party locked for the run): neutral ink. */
.cd-reason.cd-reason--info {
    color: var(--cd-text-light);
    opacity: 0.7;
}

/* XP modes: the inventory tab, full-width, stacked. Chosen = filled; locked = dimmed + the level. */
.cd-camp-mode {
    flex-shrink: 0;
    margin: 0 0 8px 0;
    -unity-text-align: middle-left;
}

.cd-camp-mode--chosen,
.cd-camp-mode--chosen:hover {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-gold);
    color: var(--cd-gold);
}

.cd-camp-focus {
    flex-shrink: 0;
    height: auto;
    min-height: 38px;
    padding: 4px 12px;
    margin: 0 0 8px 0;
    font-size: 16px;
    white-space: normal;
}

.cd-camp-split-desc {
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.75;
    white-space: normal;
    margin: 4px 2px 0 2px;
}

.cd-camp-feedback {
    margin-top: auto;
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-gold);
    white-space: normal;
    -unity-text-align: middle-center;
    min-height: 44px;
}

/* ============================================================
   Merchant - on the inventory frame too (rebuilt 2026-09-30).
   The list, and a detail column carrying the price and the action.
   ============================================================ */

.cd-shop-col--list {
    width: 440px;
    margin-right: 14px;
}

.cd-shop-restock {
    flex-shrink: 0;
    margin: 8px 0 0 0;
}

/* The hero strip's cards are Buttons here (pick who to compare against). */
.cd-inv-hero.unity-button {
    margin: 0 12px 0 0;
}

.cd-shop-price {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-gold);
}

.cd-shop-price--short {
    color: rgb(255, 150, 140);
}

/* Tall stacked menu button (full window width). */
.cd-menu-button {
    height: 54px;
    margin: 6px 0;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 20px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-menu-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-menu-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-currency-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
    /* Never the row that gives way when the window hits its height cap — see .cd-window--tall. */
    flex-shrink: 0;
}

.cd-currency-row > Label {
    margin: 0 12px;
    color: var(--cd-text-dark);
    font-size: 16px;
    -unity-font-style: bold;
}


.cd-button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

/* ---- Forge: tabs ---- */
.cd-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.cd-tab {
    padding: 6px 20px;
    margin: 0 4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-tab:hover {
    background-color: var(--cd-stone-hover);
}

.cd-tab--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

/* ---- Forge: collection grid ---- */
.cd-grid-scroll {
    flex-grow: 1;
    min-height: 220px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 4px;
    padding: 6px;
}

/* Make the scroll view's content lay cells out in a wrapping grid. */
.cd-grid-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.cd-cell {
    width: 68px;
    height: 68px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cell:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cell--locked {
    background-color: var(--cd-stone-disabled);
}

.cd-cell__icon {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-cell__q {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
}

/* ---- Forge: inspect panel ---- */
.cd-inspect {
    flex-grow: 1;
}

.cd-inspect__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cd-inspect__icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: var(--cd-stone);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inspect__titlecol {
    flex-grow: 1;
}

.cd-inspect__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__level {
    font-size: 16px;
    color: var(--cd-text-dark);
}

.cd-inspect__desc {
    white-space: normal;
    font-size: 16px;
    color: var(--cd-text-dark);
    margin-bottom: 8px;
}

.cd-inspect__effects {
    margin-bottom: 8px;
}

.cd-effect-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 6px;
    margin: 2px 0;
    background-color: var(--cd-well-soft);
    border-radius: 3px;
}

.cd-effect-row--locked {
    opacity: 0.5;
}

.cd-effect-row__text {
    font-size: 16px;
    color: var(--cd-text-dark);
}

.cd-effect-row__lock {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.cd-inspect__actions > .cd-button--narrow {
    margin-right: 8px;
}

/* ---- Victory summary (shown over the battle stage) ---- */

.cd-victory {
    width: 600px;
    max-width: 90%;
    /* Never taller than the screen: a boss's spoils list pushed the title off the top edge
       (playtest 2 finding 6). The list scrolls; the title and the buttons keep their size. */
    max-height: 88%;
    padding: 0 0 20px 0;

    background-color: var(--cd-parchment);

    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 14px;

    overflow: hidden;
    align-items: center;
}

.cd-victory__title {
    width: 100%;

    -unity-font-style: bold;
    font-size: 38px;

    color: var(--cd-text-light);
    background-color: var(--cd-frame);

    -unity-text-align: middle-center;

    padding: 12px 0;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.cd-victory > .cd-button {
    flex-shrink: 0;
}

/* The spoils list scrolls inside the frame instead of stretching it. Bottom padding on the content
   so the last row clears the scroll edge instead of sitting half under it. */
.cd-victory__scroll {
    flex-shrink: 1;
    min-height: 0;
}

.cd-victory__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 10px;
}

.cd-run-complete__run {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    -unity-text-align: middle-center;
    margin: 0 0 4px 0;
}

.cd-run-complete__message {
    font-size: 18px;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 34px 12px 34px;
}

.cd-victory__rewards {
    width: 100%;

    padding: 0 34px;
    margin-bottom: 16px;
}

.cd-victory-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding: 9px 6px;
    margin: 2px 0;

    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-victory-row__label {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    flex-shrink: 0;
    margin-right: 12px;
}

/* Long values ("Stone Sentinel, Hex Weaver and Floating Eye") wrap inside the row rather than
   running past the window's edge. */
.cd-victory-row__value {
    font-size: 22px;
    -unity-font-style: bold;

    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    flex-shrink: 1;
    white-space: normal;
}

.cd-victory-loot {
    flex-direction: row;
    align-items: center;

    padding: 6px 6px 6px 20px;
}

.cd-victory-loot__icon {
    width: 32px;
    height: 32px;

    margin-right: 10px;
    flex-shrink: 0;

    -unity-background-scale-mode: scale-to-fit;
}

.cd-victory-loot__name {
    font-size: 18px;
    color: var(--cd-text-dark);
}

/* Rarity on a reward name: doubled for the same reason as .cd-inv-detail__name's - the plain colour
   above sits later in the file at equal specificity, so the dialog rows (a cache's finds) read white. */
.cd-victory-loot__name.cd-rarity--uncommon {
    color: rgb(120, 220, 120);
}

.cd-victory-loot__name.cd-rarity--rare {
    color: rgb(110, 160, 255);
}

.cd-victory-loot__name.cd-rarity--epic {
    color: rgb(225, 130, 255);
}

.cd-victory-loot__name.cd-rarity--legendary {
    color: var(--cd-gold);
}

/* The victory window's loot, last in the list and the thing worth reading: the icon at 2x. */
.cd-victory-loot--large .cd-victory-loot__icon {
    width: 64px;
    height: 64px;
}

.cd-victory-loot--large .cd-victory-loot__name {
    font-size: 21px;
    -unity-font-style: bold;
}

/* One hero's share of the fight's XP, indented under the shared total. */
.cd-victory-row--sub {
    padding: 4px 6px 4px 24px;
    margin: 0;
    border-bottom-width: 0;
}

.cd-victory-row--sub .cd-victory-row__label,
.cd-victory-row--sub .cd-victory-row__value {
    font-size: 18px;
    -unity-font-style: normal;
}

/* ---- Scrollbars: every ScrollView under a themed root ----
   Unity's default is a wide light-grey bar with arrow buttons, which read as a stray OS control on
   the dark panels (playtest findings 6 and 15). A slim dark track with a frame-coloured thumb. */
.cd-root .unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
}

.cd-root .unity-scroller--vertical .unity-scroller__low-button,
.cd-root .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.cd-root .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(6, 3, 14, 0.6);
    border-width: 0;
    border-radius: 5px;
}

.cd-root .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--cd-frame);
    border-width: 0;
    border-radius: 5px;
    width: 10px;
    left: 0;
}

.cd-root .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--cd-accent);
}

/* ---- Level cleared window: reuses the victory frame, rows and title ---- */
.cd-level-clear {
    width: 680px;
    max-height: 88%;
}

.cd-level-clear__subtitle {
    font-size: 19px;
    color: var(--cd-gold);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 10px 24px 4px 24px;
}

.cd-level-clear__body {
    flex-shrink: 1;
    min-height: 0;
    max-height: 520px;
}

.cd-level-clear__body > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 10px;
}

.cd-level-clear__subtitle,
.cd-level-clear__next,
.cd-level-clear__choices {
    flex-shrink: 0;
}

/* An indented line under a section row: where a total came from. */
.cd-level-detail {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 6px 3px 24px;
}

.cd-level-detail__label {
    font-size: 18px;
    color: var(--cd-text-light);
    white-space: normal;
    flex-shrink: 1;
}

.cd-level-detail__value {
    font-size: 18px;
    color: var(--cd-text-light);
    -unity-text-align: middle-right;
    margin-left: 12px;
    flex-shrink: 0;
}

.cd-level-clear__next {
    font-size: 18px;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 24px 14px 24px;
}

/* Back to Town / Continue side by side. .cd-button is sized for a column; in a row the two
   size to their text instead. */
.cd-level-clear__choices {
    margin-top: 0;
    margin-bottom: 12px;
}

.cd-level-clear__choices > .cd-button {
    width: auto;
    min-width: 190px;
    margin: 0 8px;
}

/* Boss encounter banner — top-center, announces the climax fight. */
.cd-boss-banner {
    position: absolute;
    top: 48px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    padding: 10px 34px;
    background-color: rgba(40, 8, 10, 0.9);
    border-width: 2px;
    border-color: rgb(150, 40, 40);
    border-radius: 6px;
}

.cd-boss-banner__sub {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(224, 120, 110);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.cd-boss-banner__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
}

/* Summon banner: top-center, names the summon while it is on the stage. Gold, not the boss's crimson. */
.cd-summon-banner {
    position: absolute;
    top: 48px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    padding: 10px 34px;
    background-color: rgba(36, 24, 6, 0.92);
    border-width: 2px;
    border-color: rgb(214, 168, 64);
    border-radius: 6px;
}

.cd-summon-banner__sub {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 196, 110);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.cd-summon-banner__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
}

/* Merchant gear shop (buy/sell rows). */
/* A section head inside a window (Options, Pause): the inventory column title's accent and rule,
   at row-label size so it reads as a heading, not a lesser label. */
.cd-section-head {
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-accent);
    -unity-text-align: middle-left;
    padding-bottom: 4px;
    margin-top: 12px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.35);
}

.cd-subtitle {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--cd-text-dark);
    margin-top: 10px;
    margin-bottom: 2px;
}

.cd-shop-list {
    max-height: 150px;
    margin-bottom: 2px;
}

.cd-shop-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    margin: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-shop-row__icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-shop-row__name {
    flex-grow: 1;
    font-size: 16px;
    color: var(--cd-text-dark);
}

.cd-shop-row__sub {
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    opacity: 0.75;
    white-space: normal;
}

.cd-shop-row__btn {
    flex-shrink: 0;
    min-width: 96px;
}

/* Party select: a left accent bar so fielded and benched rows are distinguishable
   without reading the button. */
.cd-party-row--fielded {
    border-left-width: 3px;
    border-left-color: var(--cd-frame);
    padding-left: 5px;
}

.cd-party-row--benched {
    opacity: 0.72;
}

.cd-shop-empty {
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    padding: 6px 4px;
}

/* Utility: hidden (controller toggles this). */
.cd-hidden {
    display: none;
}

.cd-command-window,
.cd-party-status,
.cd-turn-order {
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--cd-frame);
}

.cd-cmd-row,
.cd-sel-row,
.cd-party-row,
.cd-turn-row {
    border-radius: 8px;
}

.cd-button {
    border-radius: 10px;
}

/* Bright active selection */

.cd-cmd-row--selected,
.cd-sel-row--selected,
.cd-party-row--active {
    background-color: rgb(102, 48, 158);
    border-width: 2px;
    border-color: var(--cd-accent);
    border-radius: 8px;
}

/* The unit acting now pops out of the column: a bigger gold-framed tile pushed left past the
   panel's edge, FFX-style, so "who acts" never needs finding (2026-09-30). */
.cd-turn-row--current,
.cd-turn-row--current.cd-turn-row--enemy {
    width: 64px;
    height: 64px;
    margin: 0 0 6px 0;
    translate: -22px 0;
    background-color: rgb(102, 48, 158);
    border-width: 3px;
    border-color: var(--cd-gold);
    border-radius: 8px;
}

.cd-turn-row--current.cd-turn-row--enemy {
    background-color: rgb(96, 28, 40);
}

.cd-turn-row--current .cd-turn-row__icon {
    width: 54px;
    height: 54px;
}

/* Hover */

.cd-cmd-row:hover,
.cd-sel-row:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

/* Brighter glossy-looking headers */

.cd-party-status__header,
.cd-command-window__header {
    background-color: rgb(67, 30, 108);
    color: var(--cd-gold);

    border-bottom-width: 1px;
    border-bottom-color: var(--cd-accent);
}

/* ============================================================
   Enemy knowledge ("Scan") — the in-combat Inspect page and the
   hub bestiary render the same rows, so they share these classes.
   Tone classes come from BestiaryLineView.ToneClass; nothing else
   should decide what a known/unknown value looks like.
   ============================================================ */

.cd-scan__header {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgb(67, 30, 108);
    border-bottom-width: 1px;
    border-bottom-color: var(--cd-accent);
}

.cd-scan__portrait {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    background-color: var(--cd-stone);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-scan__titlecol {
    flex-grow: 1;
}

.cd-scan__name {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--cd-gold);
}

.cd-scan__health {
    font-size: 16px;
    color: var(--cd-text-light);
}

.cd-scan__body {
    flex-grow: 1;
    min-height: 140px;
    max-height: 320px;
    margin: 8px 12px;
    padding: 6px 8px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 4px;
}

/* The in-combat Inspect page: a page to read, so wider and taller than the pickers it shares
   .cd-window--combat with, and split in two columns (playtest finding 15 - it was a 380px box
   that scrolled through five sections). */
.cd-scan-window {
    width: 760px;
    max-width: 72%;
    max-height: 82%;
}

/* Docked left, not centred: the enemies stand in the right half of the stage, and a centred page
   covered the one being read about (menu review, 2026-09-28). Top-anchored in px rather than
   translated by a percentage, so a taller page grows downward instead of re-centring. */
.cd-dock-inspect {
    position: absolute;
    left: 16px;
    top: 72px;
}

.cd-scan-window .cd-scan__body {
    max-height: none;
    flex-shrink: 1;
}

.cd-scan__cols {
    flex-direction: row;
    align-items: flex-start;
}

.cd-scan__col {
    flex-grow: 1;
    flex-basis: 0;
}

.cd-scan__col--right {
    margin-left: 18px;
    padding-left: 18px;
    border-left-width: 1px;
    border-left-color: rgba(205, 110, 255, 0.25);
}

/* Rows that carry their own label on the first row (the drop table), set off from the section
   above them without a heading of their own. */
.cd-scan__group {
    margin-top: 8px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(205, 110, 255, 0.35);
}

/* A section heading inside the page ("Resistances", "Draw", ...). */
.cd-scan__section {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-accent);
    margin-top: 8px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.35);
}

.cd-scan__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 4px;
}

.cd-scan__label {
    font-size: 16px;
    color: var(--cd-text-light);
}

.cd-scan__value {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    /* A one-row drop list ("Scrap Iron  ·  1 not yet seen") wraps rather than running off the page. */
    flex-shrink: 1;
    white-space: normal;
    margin-left: 12px;
}

.cd-scan__label {
    flex-shrink: 0;
}

/* In the player's favour — a weakness to exploit, loot they have seen drop. */
.cd-scan__value--good {
    color: rgb(255, 217, 102);
}

/* Against the player — resisted, immune, absorbed, or an element aimed at the party. */
.cd-scan__value--bad {
    color: rgb(154, 178, 217);
}

.cd-scan__value--neutral {
    color: var(--cd-text-light);
}

/* Not yet observed. Dim on purpose: an unread row should read as a gap in the record,
   not as a value. */
.cd-scan__value--unknown {
    color: rgb(122, 106, 146);
}

/* An element's name in its own colour (BestiaryLineView.ElementClass), on a resistance row's label
   and the "Attacks with" value. After the tone classes so the element wins on the one row that
   carries both: the name is the element, the tone is already in the resistance word beside it. */
.cd-element {
    -unity-font-style: bold;
}

.cd-element--normal {
    color: rgb(214, 204, 192);
}

.cd-element--fire {
    color: rgb(255, 140, 64);
}

.cd-element--ice {
    color: rgb(128, 204, 255);
}

.cd-element--lightning {
    color: rgb(250, 226, 92);
}

.cd-element--holy {
    color: rgb(255, 242, 196);
}

.cd-element--shadow {
    color: rgb(178, 128, 255);
}

/* ---- Hub bestiary ---- */

/* ---- Bestiary on the inventory frame (2026-09-30) ---- */
.cd-bestiary__portrait {
    width: 96px;
    height: 96px;
}

/* The page's two columns: what hurts it | what it is. */
.cd-bestiary__page {
    flex-direction: row;
}

.cd-bestiary__page-col {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 14px;
}

/* An enemy not yet met: a compact row, never selected, so the gaps show without owning the list. */
.cd-bestiary-row--unknown {
    height: 26px;
    padding-left: 14px;
    opacity: 0.5;
}

.cd-bestiary-row--unknown .cd-inv-row__icon {
    display: none;
}

.cd-bestiary-row--unknown .cd-inv-row__name {
    font-size: 16px;
    -unity-font-style: italic;
}

.cd-bestiary__cols {
    flex-direction: row;
    flex-grow: 1;
    min-height: 300px;
}

.cd-bestiary__list {
    width: 40%;
    margin-right: 10px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 4px;
    padding: 6px;
}

.cd-bestiary__detail {
    flex-grow: 1;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 4px;
    padding: 6px 10px;
}

/* An enemy row in the left-hand list. */
.cd-bestiary-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 2px 0;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-bestiary-row:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

.cd-bestiary-row--selected {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-accent);
}

/* Never met: still listed, so the collection has a visible shape. */
.cd-bestiary-row--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.75;
}

.cd-bestiary-row__icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-bestiary-row__name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
}

.cd-bestiary-row__kills {
    font-size: 16px;
    color: rgb(180, 164, 204);
}

/* ============================================================
   Sphere grid — shared graph view (hub screen + editor window)

   Restored after the dark-theme pass dropped the tail of this file; the
   graph screens render nothing without it (see .sg-viewport / .sg-node).
   Everything below is expressed in --cd-* tokens so it follows the theme,
   except the two inset panel fills, which are deliberate blacks.
   ============================================================ */

/* A wider window: the pannable graph plus its detail panel need more than 620px. */
.cd-window--wide {
    width: 1140px;
}

/* The graph viewport. overflow:hidden clips the pannable content, so nothing can spill
   out and swallow clicks meant for the buttons beneath it (the ScrollView trap). */
.sg-viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* The panned/zoomed content plane. transform-origin must be the top-left corner:
   UITK's default is 50% 50%, which makes scaling orbit the element's center and
   desyncs the zoom-toward-cursor math. */
.sg-content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: left top;
}

.sg-node {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: var(--cd-frame);
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone-disabled);
    margin: 0;
    padding: 0;
}

.sg-node:hover {
    border-color: var(--cd-accent);
}

/* Activation states (SphereGridPresenter.StateClass drives these). */
.sg-node--activated {
    background-color: var(--cd-accent);
}

/* Affordable now: an open ring in the accent colour, against the solid fill of an owned node
   and the plain frame of a reachable node the bank cannot pay for yet. */
.sg-node--available {
    background-color: rgb(24, 12, 40);
    border-color: var(--cd-accent);
}

.sg-node--available .sg-node__glyph {
    color: var(--cd-accent);
}

.sg-node--adjacent {
    background-color: var(--cd-stone);
}

.sg-node--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.45;
}

/* The cursor: a thick gold ring and a lift, readable at any zoom (a 1px white ring was not). */
.sg-node--selected {
    border-color: var(--cd-gold);
    border-width: 5px;
    scale: 1.25;
    opacity: 1;
}

/* Editor connect-mode source highlight. Gold rather than the theme's parchment, which is
   now a near-black ink and would read as no highlight at all. */
.sg-node--source {
    border-color: var(--cd-gold);
}

/* Kind accents. */
.sg-node--start {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    border-width: 4px;
}

.sg-node__glyph {
    color: var(--cd-text-light);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* A stat node's short name ("STR", "HP") inside the same 44px circle. */
.sg-node__glyph--word {
    font-size: 12px;
}

/* Filled nodes are the theme's brightest surfaces, so their glyph flips to dark ink —
   --cd-text-dark is itself near-white in this theme and would vanish. */
.sg-node--activated .sg-node__glyph {
    color: var(--cd-parchment);
}

/* Screen layout: graph on the left, always-present detail panel on the right, so the
   window's size never changes between states (the dock-center hit-test trap). */
.sg-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
}

.sg-detail {
    width: 300px;
    flex-shrink: 0;
    margin-left: 10px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* ---- Sphere grid screen on the inventory frame (2026-09-30) ---- */
.sg-graph-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 14px;
}

.sg-detail-col {
    width: 330px;
}

.sg-detail__chips {
    flex-direction: row;
    flex-shrink: 0;
    margin: 6px 0 4px 0;
}

.sg-detail__payload {
    flex-shrink: 0;
    -unity-font-style: normal;
}

.sg-detail__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.sg-detail__cost {
    flex-shrink: 0;
    -unity-font-style: bold;
    color: var(--cd-gold);
}

.sg-activate {
    flex-shrink: 0;
    margin: 6px 0 4px 0;
}

.sg-feedback {
    min-height: 24px;
    margin-top: 0;
}

/* Banked XP, as a tab on the portrait card's top edge - the leader tab's shape. */
.sg-hero-xp {
    position: absolute;
    top: -12px;
    align-self: center;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    background-color: rgb(67, 30, 108);
    border-width: 1px;
    border-color: var(--cd-gold);
    border-radius: 5px;
    padding: 0 6px;
    margin: 0;
}

/* ---- Story map screen on the inventory frame (2026-09-30) ---- */
.cm-graph-col {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 14px;
}

.cm-graph-host {
    flex-grow: 1;
}

.cm-legend {
    flex-shrink: 0;
    font-size: 16px;
    color: var(--cd-text-light);
    opacity: 0.7;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.cm-detail-col {
    width: 330px;
}

.cm-detail__status {
    color: var(--cd-gold);
    opacity: 1;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.cm-detail__requires {
    height: auto;
    white-space: normal;
}

.cm-detail__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

/* A floor of the run: cleared, the one you are on, or still ahead. */
.cm-floor {
    font-size: 17px;
    color: var(--cd-text-light);
    padding: 1px 4px;
    margin: 0;
}

.cm-floor--done {
    opacity: 0.55;
}

.cm-floor--current {
    color: var(--cd-gold);
    -unity-font-style: bold;
}

.cm-floor--ahead {
    opacity: 0.85;
}

/* A line of the run's attempt history (docs/plans/POLISH_CONTENT.md §15): long enough to wrap. */
.cm-attempt {
    white-space: normal;
}

.cm-start {
    flex-shrink: 0;
    margin-top: 4px;
}

/* ---- Revisit conditions (docs/plans/REVISITS.md) ---- */
/* The rows scroll inside the detail body (which clips), and the fear summary below keeps its
   height. Its own scroller stays thin so it does not eat the row width. */
.cm-fear-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.cm-fear-summary {
    flex-shrink: 0;
}

/* One condition: a button so the mouse can cycle its rank; the map's own cursor walks them. */
.cm-fear-row {
    flex-direction: column;
    align-items: stretch;
    margin: 2px 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(236, 190, 72, 0.25);
    border-radius: 3px;
    -unity-text-align: upper-left;
}

.cm-fear-row--on {
    border-color: var(--cd-gold);
    background-color: rgba(236, 190, 72, 0.10);
}

.cm-fear-row--cursor {
    border-color: var(--cd-text-light);
    border-width: 2px;
}

.cm-fear-row__head {
    flex-direction: row;
    justify-content: space-between;
}

.cm-fear-row__name {
    font-size: 17px;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0;
}

.cm-fear-row--on .cm-fear-row__name {
    color: var(--cd-gold);
    -unity-font-style: bold;
}

.cm-fear-row__rank {
    font-size: 15px;
    color: var(--cd-gold);
    padding: 0;
    margin: 0;
}

.cm-fear-row__desc {
    font-size: 14px;
    color: var(--cd-text-light);
    opacity: 0.8;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.cm-fear-summary {
    font-size: 16px;
    color: var(--cd-gold);
    white-space: normal;
    padding: 2px 4px;
    margin: 2px 0 0 0;
}

/* ---- Level entry (progress-view), one fixed size (2026-09-30) ---- */
.hub-entry {
    width: 760px;
    height: 440px;
    max-height: none;
    padding: 0;
    overflow: hidden;
    flex-direction: column;
}

.hub-entry__body {
    flex-grow: 1;
    min-height: 0;
    padding: 18px 22px 6px 22px;
    align-items: center;
}

.hub-entry__name {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.hub-entry__pips {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 18px;
}

.hub-entry__pip {
    width: 22px;
    height: 22px;
    margin: 0 5px;
    border-width: 2px;
    border-color: var(--cd-accent);
    border-radius: 11px;
}

.hub-entry__pip--done {
    background-color: var(--cd-accent);
}

.hub-entry__pip--current {
    border-color: var(--cd-gold);
    border-width: 4px;
    width: 28px;
    height: 28px;
    border-radius: 14px;
}

.hub-entry__pip--ahead {
    opacity: 0.55;
}

.hub-entry__party-title {
    align-self: stretch;
}

.hub-entry__party {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
}

.hub-entry__hero {
    width: 124px;
    height: 118px;
    margin: 0 6px;
    padding: 4px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(35, 18, 58, 0.6);
    border-width: 2px;
    border-color: rgba(91, 42, 145, 0.7);
    border-radius: 8px;
}

.hub-entry__hero-sprite {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.hub-entry__hero-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0;
}

.hub-entry__hero-hp {
    font-size: 16px;
    color: rgb(150, 230, 150);
    padding: 0;
    margin: 0;
}

/* Doubled: .hub-lotpanel__actions' padding shorthand sits later in the file and would win. */
.hub-lotpanel__actions.hub-entry__actions {
    padding: 0 18px 18px 18px;
}

/* The primary action: filled, so it reads as the way forward before the cursor is on it. */
.hub-entry__enter {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-gold);
    color: var(--cd-gold);
    flex-grow: 1.4;
}

/* ---- Campaign map ---- */
/* The map reuses SphereGridView, so nodes keep the .sg-node geometry and only the state
   vocabulary differs (CampaignPresenter.StateClasses drives these). Separate class names
   rather than reusing sg-node--* so the two graphs cannot clear each other's states. */

.cm-node--completed {
    background-color: var(--cd-accent);
}

.cm-node--available {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

/* The run underway: gold fill so it reads as "you are here" at a glance. */
.cm-node--active {
    background-color: var(--cd-gold);
    border-color: var(--cd-text-light);
}

.cm-node--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.45;
}

/* The node caption (SphereGridView.NodeInfo.Caption) - only the campaign map sets one, so
   this rule never reaches a sphere grid node. Hangs below the circle, centred on it. */
.sg-node__caption {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    margin-top: 6px;
    padding: 1px 6px;
    font-size: 17px;
    color: var(--cd-text-light);
    background-color: rgba(6, 3, 14, 0.7);
    border-radius: 4px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.cm-node--active .sg-node__caption {
    color: var(--cd-gold);
    -unity-font-style: bold;
}

/* Optional side branches are outlined rather than filled, so the main line reads first. */
.cm-node--optional {
    border-color: var(--cd-stone-hover);
}

.cm-node--completed .sg-node__glyph,
.cm-node--active .sg-node__glyph {
    color: var(--cd-parchment);
}

/* ---- Home window sizing ---- */
/* Home stacks ten menu buttons plus the purse. At the shared 62% cap the flex layout
   ran out of room and squeezed the last child to zero height, so Gold/Essence rendered outside
   the frame. The purse must never be the row that gives way, and the window needs the headroom.
   Measured in play mode (2026-09-01): the content is 799.5 units against this 884.4 cap, so there
   is room for roughly ONE more button. Do not raise the cap much past 88% to buy more - .cd-window
   also carries margin-bottom: 8%, so 92% puts the frame against the top edge. */

.cd-window--tall {
    max-height: 88%;
}

/* ---- Options: stepped dials ----
   The volume rows are buttons rather than a UITK Slider on purpose: the hub's keyboard cursor
   navigates buttons, so a slider would be a hole in a screen the player is meant to be able to
   reach without a mouse. A step is 10% — see AudioOptions.Step. */

.cd-option-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

/* A fixed column, so the dials line up under each other instead of the label hugging the left
   edge and the buttons the right with nothing between. */
.cd-option-label {
    width: 180px;
    flex-shrink: 0;
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-font-style: bold;
}

/* The level as ten segments between the nudge buttons (one per AudioOptions.Step), so it reads
   at a glance; the percentage follows, dimmer, for whoever wants the number. */
.cd-option-bar {
    flex-grow: 1;
    flex-direction: row;
    height: 22px;
    margin: 0 8px;
}

.cd-option-seg {
    flex-grow: 1;
    margin: 0 2px;
    border-radius: 2px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
}

.cd-option-seg--on {
    background-color: var(--cd-accent);
    border-color: var(--cd-accent);
}

/* Muted: the dials keep their setting, but nothing is playing, so the lit segments go dim. */
.cd-option-bar--muted .cd-option-seg--on {
    opacity: 0.35;
}

.cd-option-value {
    width: 64px;
    flex-shrink: 0;
    color: rgb(200, 190, 225);
    font-size: 16px;
    -unity-text-align: middle-right;
}

/* The mute toggle, sized like the dial row it sits in rather than like a menu choice. */
.cd-option-toggle {
    width: 120px;
    height: 40px;
    margin-top: 0;
}

/* A square nudge button. Fixed width so the two sit either side of the readout without the row
   reflowing as the number changes width (9% and 100% are different sizes). */
.cd-button--step {
    width: 52px;
    height: 40px;
    margin-top: 0;
    padding: 0;
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* The dimmed town behind a service window (HubManager.CoverTown). It takes the clicks, so the
   inert town under it cannot be reached by the mouse either. */
.hub-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 3, 14, 0.5);
}

/* ============================================================
   The hub town (HubView). One authored pixel rect, letterboxed
   as a single unit — the scale lives on .hub-canvas, never on a
   lot, because UITK applies a transform to hit-testing as well
   as to paint, and scaling lots individually is what desyncs a
   click from the pixel it landed on.

   Every lot is a flat rectangle until BuildingSO carries real
   sprites: that is the placeholder-art bargain HUB.md §7 phase 3
   assumed, and it is why the glyph and label matter — they are
   the only thing telling the Forge from the Bestiary.
   ============================================================ */

/* The town is the screen, not a window on it: full-bleed, with every service docking over it.
   That is also why home no longer has to fit ten buttons inside a 62%-tall frame. */
.hub-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    flex-direction: column;
}

.hub-town {
    flex-grow: 1;
}

.hub-view__viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(9, 5, 18);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.hub-canvas {
    overflow: visible;
}

.hub-backdrop {
    background-color: rgb(18, 10, 34);
    -unity-background-scale-mode: scale-and-crop;
}

/* One building's sprite. Its own layer beneath the hit boxes, so silhouettes may overlap
   each other and spill past the box you click - which is what makes a town look painted
   rather than tiled. Never picks: input belongs to .hub-lot above it. */
.hub-art {
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.28s, 0.28s;
    transition-timing-function: ease-out, ease-out;
}

/* An unbuilt lot's foundation still has to be seen - it is the affordance that makes a
   material worth wanting, so it is dimmed only enough to read as unfinished. */
/* The art layer shares the lot's state classes, and .hub-lot--available / --absent paint a faint
   slab for a lot with no art - which drew a dark box behind the foundation sprite. The art never
   takes the slab. */
.hub-art.hub-lot--available,
.hub-art.hub-lot--absent,
.hub-art.hub-lot--built {
    background-color: rgba(0, 0, 0, 0);
}

.hub-art.hub-lot--available {
    opacity: 0.92;
}

.hub-art.hub-lot--absent {
    opacity: 0.28;
}

/* Nothing authored yet: draw no ghost box, let the flat .hub-lot slab do the work. */
.hub-art--empty {
    background-color: rgba(0, 0, 0, 0);
}

/* The build animation, and it works the way round you might not expect: this is the
   STARTING state. HubView adds it, lets a frame lay out, then removes it - the sprite
   then transitions from here back to its resting opacity and scale. Done the other way
   (a class that sets the end state) nothing moves, because the end state is the default
   and a USS transition only runs on a change. */
.hub-art--phasing {
    opacity: 0;
    scale: 0.82 0.82;
}

/* The town's living lights (HubView ambience, HubAmbience for the maths). Sizes and positions
   come from code; these only say what each thing looks like. A glow is the stepped fx_glow
   sprite tinted per light, a spark one backdrop pixel of colour, smoke a grey square that grows.
   Opacity is driven every tick, so none of these may carry a transition. */
.hub-fx-glow {
    -unity-background-scale-mode: stretch-to-fill;
}

.hub-fx-ember {
    background-color: rgb(255, 200, 120);
}

.hub-fx-smoke {
    background-color: rgb(176, 168, 190);
}

.hub-fx-star {
    background-color: rgb(235, 232, 255);
}

.hub-lot {
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
    padding: 6px;
    margin: 0;
    color: var(--cd-text-light);
    align-items: center;
    justify-content: flex-end;
    -unity-background-scale-mode: scale-to-fit;
}

.hub-lot:hover {
    background-color: var(--cd-stone-hover);
}

/* A lot carrying real art keeps the sprite, not the slab. Doubled class so it also beats
   .hub-lot--available / --absent further down, whose faint slab otherwise sat over the art. */
.hub-lot.hub-lot--art {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* Hover and the keyboard cursor OUTLINE a building rather than fill its hitbox. The sprite
   is a separate layer beneath the lot, so the shared fills (.hub-lot:hover, .cd-nav--selected)
   painted an opaque purple slab straight over the art - a hovered Merchant read as a purple
   box (playtest, 2026-09-28). The extra .hub-lot in each selector is for specificity:
   .cd-nav--selected:hover is later in this file and would otherwise win. */
.hub-lot.hub-lot--art:hover,
.hub-lot.hub-lot--art.cd-nav--selected,
.hub-lot.hub-lot--art.cd-nav--selected:hover {
    background-color: rgba(205, 110, 255, 0.08);
    border-width: 2px;
    border-color: var(--cd-accent);
}

.hub-lot.hub-lot--art.cd-nav--selected {
    border-color: var(--cd-gold);
}

.hub-lot__glyph {
    font-size: 34px;
    color: var(--cd-accent);
    -unity-text-align: middle-center;
}

/* Name + note, hung below the lot so they never sit on its art (see HubView.MakeLot). */
.hub-lot__caption {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    margin-top: 4px;
    align-items: center;
}

.hub-lot__caption--above {
    top: auto;
    bottom: 100%;
    margin-top: 0;
    margin-bottom: 4px;
}

.hub-lot__label {
    font-size: 18px;
    white-space: nowrap;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    background-color: rgba(9, 5, 18, 0.8);
    padding: 0 6px;
    border-radius: 3px;
}

/* The caption is one line now: the name and, beside it, a badge in place of the old cost line. */
.hub-lot__caption {
    flex-direction: row;
}

.hub-lot__badge {
    width: 30px;
    height: 30px;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Something waits inside: a gold pip, drawn rather than an icon. */
.hub-lot__badge--new {
    width: 16px;
    height: 16px;
    margin: 0 0 0 6px;
    align-self: center;
    background-color: var(--cd-gold);
    border-width: 2px;
    border-color: rgb(60, 36, 10);
    border-radius: 8px;
}

/* Something to build or raise here. */
.hub-lot__badge--build {
    background-image: url("project://database/Assets/UI/Icons/hub_hammer.png");
}

/* Not on offer yet. */
.hub-lot__badge--locked {
    background-image: url("project://database/Assets/UI/Icons/hub_lock.png");
    opacity: 0.85;
}

.hub-lot__note {
    font-size: 17px;
    white-space: nowrap;
    margin-top: 2px;
    color: var(--cd-gold);
    -unity-text-align: middle-center;
    background-color: rgba(9, 5, 18, 0.8);
    padding: 0 5px;
    border-radius: 3px;
}

/* The campfire's three split buttons, side by side so the choice reads as one
   decision rather than three unrelated toggles. The chosen one is filled in;
   a mode the campfire cannot grant yet is dimmed rather than hidden, so the
   player can see what raising the fire would buy before paying for it. */
.cd-split-row {
    flex-direction: row;
    justify-content: center;
    margin: 2px 0 4px 0;
}

/* .cd-button--narrow is width:45%, which three abreast overflows the window by
   a third. In a row they share the width instead: flex-basis 0 so they size off
   the row rather than the text, and min-width 0 so a long locked label ("Mentor
   - Lv 2") shrinks rather than pushing its neighbours out through the border. */
.cd-split-row > .cd-button {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 4px;
    font-size: 16px;
}

/* The "who is mentored" cycle button. Wider than .cd-button--narrow and allowed
   to wrap, because it carries a hero NAME - an unwrapped 45% button spills its
   text over the rows either side of it, which is how this was found. */
.cd-split-focus {
    width: 80%;
    align-self: center;
    white-space: normal;
    height: auto;
    min-height: 34px;
    padding: 4px 10px;
    font-size: 16px;
    margin-top: 4px;
}

.cd-split-option--chosen {
    background-color: rgb(94, 58, 150);
    border-color: var(--cd-gold);
}

/* ---- The lot panel (lot-view), one fixed size in every state (2026-09-30) ---- */
.hub-lotpanel {
    width: 760px;
    height: 420px;
    max-height: none;
    padding: 0;
    overflow: hidden;
    flex-direction: column;
}

.hub-lotpanel__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 16px 18px 6px 18px;
}

/* The building at 3x its 64px art, on the town's own night ground colour. */
.hub-lotpanel__art {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    margin-right: 18px;
    background-color: rgba(0, 0, 0, 0.32);
    border-width: 1px;
    border-color: rgba(205, 110, 255, 0.22);
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Not built yet: what it will become, dimmed. */
.hub-lotpanel__art--preview {
    opacity: 0.5;
}

.hub-lotpanel__info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.hub-lotpanel__costs {
    flex-shrink: 0;
    margin-bottom: 10px;
}

.hub-lotpanel__cost {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.hub-lotpanel__cost-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.hub-lotpanel__cost-name {
    flex-grow: 1;
    font-size: 17px;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0;
}

.hub-lotpanel__cost-count {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    padding: 0;
    margin: 0;
}

.hub-lotpanel__cost-count--short {
    color: rgb(255, 130, 120);
}

.hub-lotpanel__grant {
    color: var(--cd-gold);
}

.hub-lotpanel__actions {
    flex-direction: row;
    flex-shrink: 0;
    padding: 0 18px;
}

.hub-lotpanel__back {
    margin-left: 6px;
}

.hub-lotpanel__reason {
    padding: 0 20px;
    margin: 4px 0 0 0;
}

.hub-lotpanel__feedback {
    margin-top: 0;
    min-height: 26px;
}

/* The promise beside the price in the lot panel: what the next level actually
   grants. Wraps, because .cd-info-label does not — a UITK label defaults to
   nowrap and a sales line long enough to be worth reading walks straight out
   through the window's border. Gold, the same colour the lot's own note uses
   for "here is what this costs you". */
.hub-lot-grant {
    white-space: normal;
    color: var(--cd-gold);
    font-size: 16px;
    max-width: 100%;
    margin: 2px 4px 10px 4px;
}

/* Built is the ordinary state. Available is a bare foundation — it has to read
   as an invitation, which is the whole reason a material is worth wanting. */
.hub-lot--available {
    background-color: rgba(35, 18, 58, 0.45);
    border-color: rgb(70, 52, 96);
}

.hub-lot--available .hub-lot__glyph {
    color: rgb(96, 78, 122);
}

.hub-lot--absent {
    background-color: rgba(20, 12, 32, 0.35);
    border-color: rgb(44, 32, 62);
    opacity: 0.55;
}

/* The road out of town. Not a lot: the story is the way out, not a service, and
   a building must never be able to lock the player out of running. */
.hub-road {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -50%;
    width: 150px;
    height: 190px;
    margin: 0;
    background-color: var(--cd-stone);
    border-width: 3px;
    border-color: var(--cd-gold);
    border-radius: 6px;
    color: var(--cd-gold);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 8px;
    white-space: normal;
}

.hub-road:hover {
    background-color: var(--cd-stone-hover);
}

/* The road is a signpost on the painted road (2026-09-30), not a panel: the sprite fills the top
   of the button and the caption sits under it. Hover and the keyboard cursor outline it, as a lot
   is outlined, rather than filling it (the doubled class beats .cd-nav--selected). */
.hub-road.hub-road--art {
    width: 192px;
    height: 226px;
    right: 8px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Sprites/Hub/hub_signpost.png");
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: top;
    border-width: 0;
    -unity-text-align: lower-center;
    padding: 0 0 2px 0;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.hub-road.hub-road--art:hover,
.hub-road.hub-road--art.cd-nav--selected,
.hub-road.hub-road--art.cd-nav--selected:hover {
    background-color: rgba(236, 190, 72, 0.08);
    border-width: 2px;
    border-color: var(--cd-gold);
}

.hub-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 60px;
    padding: 0 14px;
    /* The town frame's closing band: the viewport's border carried on round the bottom, in the
       inventory header's purple, so the bar reads as part of the frame rather than loose under it. */
    background-color: rgb(67, 30, 108);
    border-width: 0 2px 2px 2px;
    border-color: var(--cd-frame);
    border-top-width: 1px;
    border-top-color: var(--cd-accent);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.hub-town .hub-view__viewport {
    border-bottom-width: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.hub-purse {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.hub-purse__chip {
    align-items: flex-end;
    min-width: 96px;
    padding: 3px 12px;
    margin-left: 8px;
    background-color: var(--cd-well);
    border-width: 1px;
    border-color: var(--cd-well-border);
    border-radius: 6px;
}

.hub-purse__value {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cd-gold);
    margin: 0;
    padding: 0;
}

.hub-purse__chip--essence .hub-purse__value {
    color: var(--cd-accent);
}

.hub-purse__label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(200, 190, 225);
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
}

/* .cd-button--narrow is 45% of its parent, which is the whole screen width down here.
   The bar is a row, so its buttons size to their content instead. */
.hub-bar .cd-button {
    width: auto;
    align-self: center;
    margin-top: 0;
}

.hub-bar .cd-feedback {
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin: 0 12px;
}

/* ============================================================
   The tutorial (docs/TUTORIAL.md). One banner saying one line,
   and a pulsing gold outline on whatever it points at. The pulse
   is HubManager toggling .cd-tutorial--pulse on the root every
   600ms; the transitions below do the easing.
   ============================================================ */

.cd-tutorial-banner {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    max-width: 820px;
    padding: 10px 20px;
    background-color: rgba(9, 5, 18, 0.94);
    border-width: 3px;
    border-color: var(--cd-gold);
    border-radius: 8px;
}

.cd-tutorial-banner__text {
    font-size: 21px;
    color: var(--cd-text-light);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Over a tall window (the sphere grid's 720px frame) - one line in the strip above it. That strip is
   only ~59px on a 16:9-ish game view (measured 2026-10-02), so every pixel here is counted. */
.cd-tutorial-banner--compact {
    top: 4px;
    padding: 4px 16px;
    border-width: 2px;
    max-width: 1100px;
}

.cd-tutorial-banner--compact .cd-tutorial-banner__text {
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.cd-tutorial-target {
    border-width: 4px;
    border-color: var(--cd-gold);
    transition-property: border-color;
    transition-duration: 0.5s;
}

.cd-tutorial--pulse .cd-tutorial-target {
    border-color: rgb(255, 246, 205);
}

/* A lot with art has no border of its own (.hub-lot.hub-lot--art), so the outline needs the
   extra specificity to show up at all. */
.hub-lot.hub-lot--art.cd-tutorial-target {
    border-width: 4px;
    border-color: var(--cd-gold);
    background-color: rgba(255, 205, 90, 0.12);
}

.cd-tutorial--pulse .hub-lot.hub-lot--art.cd-tutorial-target {
    border-color: rgb(255, 246, 205);
}

.sg-node.cd-tutorial-target {
    border-width: 5px;
    border-color: var(--cd-gold);
    scale: 1.15;
    transition-property: border-color, scale;
    transition-duration: 0.5s, 0.5s;
}

.cd-tutorial--pulse .sg-node.cd-tutorial-target {
    border-color: rgb(255, 246, 205);
    scale: 1.3;
}

/* The arrow over a guided lot, bobbing with the pulse. */
.hub-lot__pointer {
    position: absolute;
    bottom: 100%;
    left: 50%;
    translate: -50% 0;
    margin-bottom: 6px;
    font-size: 46px;
    color: var(--cd-gold);
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.cd-tutorial--pulse .hub-lot__pointer {
    translate: -50% -16px;
}

/* What the tutorial has locked: still visible, plainly not for now. */
.hub-lot:disabled {
    opacity: 0.45;
}

.hub-road:disabled,
.hub-bar .cd-button:disabled {
    opacity: 0.4;
}

/* ============================================================
   Keyboard cursor — the arrow-key highlight painted by
   ImmoralityGaming.Menu.KeyboardNavigator on whichever button
   the cursor is on. Deliberately the last rule in the file:
   every button class here (.cd-menu-button, .cd-button, .cd-tab,
   the shop-row buttons) is a single-class selector of equal
   specificity, so source order is what makes the cursor win over
   the button's own background. Border width matches theirs (2px)
   so highlighting never nudges a layout.
   ============================================================ */

/* One cursor look for buttons, the Storehouse's: purple fill, WHITE text (gold on this purple was
   the lowest-contrast text in the game, 2026-09-30). World objects - lots, the signpost - keep their
   gold outline instead (.hub-lot--art / .hub-road--art). */
.cd-nav--selected {
    background-color: rgb(102, 48, 158);
    border-width: 2px;
    border-color: var(--cd-accent);
    color: var(--cd-text-light);
}

.cd-nav--selected:hover {
    background-color: rgb(126, 62, 190);
    border-color: rgb(156, 82, 210);
}

.cd-nav--selected:disabled {
    background-color: var(--cd-stone-disabled);
    border-color: var(--cd-frame);
}

/* Keyboard hint line, bottom-centre under the room bar. Deliberately quiet:
   it is there to be found once, not read every room. */
/* Full-width and text-centred rather than left 50% + translate -50%: the percentage translate was
   not recomputed when the text changed width, so the hint drifted ~85px left of the bar it belongs
   to after the first Fight bar (2026-09-30). */
.cd-nav-hint {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: var(--cd-text-dark);
    opacity: 0.7;
}

/* While the pause overlay is up, the room bar, the command menu and the hint under them are hidden
   (visibility, not display, so every "which bar is up" check in RoomActionUI still reads true and the
   shared cursor skips them). A highlighted Fight button under the pause window was a second cursor. */
.cd-root--paused > #main-bar,
.cd-root--paused > #combat-bar,
.cd-root--paused > #hero-bar,
.cd-root--paused > #nav-hint {
    visibility: hidden;
}

/* ============================================================
   Dungeon map (.dm-*) — the floor overlay in RoomAction.uxml.
   Drawn by DungeonMapView with Painter2D; the colours it strokes
   mirror the --cd-* tokens above, so change the two together.
   ============================================================ */

/* Wider than a command window and taller than a dialog: the map IS the content, and a floor
   drawn small enough to fit a 620px frame is a floor nobody can read. */
.cd-window--map {
    width: 900px;
    max-width: 94%;
    max-height: 86%;
}

/* The host authored in UXML. DungeonMapView is added into it and fills it. */
.dm-host {
    flex-grow: 1;
    min-height: 340px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
    overflow: hidden;
}

.dm-viewport {
    flex-grow: 1;
    overflow: hidden;
}

/* One room's marker. Absolutely positioned over the painted box by the view, so the glyph and the
   rectangle can never drift apart. */
.dm-glyph {
    position: absolute;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 15px;
    color: var(--cd-text-dark);
}

.dm-glyph--enemies {
    color: rgb(232, 96, 96);
}

.dm-glyph--captive {
    color: rgb(120, 220, 255);
}

.dm-glyph--event {
    color: var(--cd-accent);
}

.dm-glyph--cache {
    color: var(--cd-gold);
}

.dm-glyph--refuge {
    color: rgb(120, 226, 140);
}

.dm-glyph--exit {
    color: var(--cd-gold);
}

/* The legend: one line, wrapping if the window is narrow, sharing the glyph colours above so the
   key and the map cannot disagree. */
.dm-legend {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2px;
}

.dm-legend__item {
    flex-direction: row;
    align-items: center;
    margin: 2px 8px;
}

.dm-legend__glyph {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 4px;
    padding: 0;
}

/* The diamond sits small in this font's em box, so at the others' size it read as a dot. */
.dm-legend__glyph.dm-glyph--cache {
    font-size: 26px;
}

.dm-legend__text {
    font-size: 16px;
    color: var(--cd-text-light);
    margin: 0;
    padding: 0;
}

/* A little room box in the two looks DungeonMapView paints: the party's room (gold border on the
   hover-stone fill) and a room not yet entered (the frame colour, unfilled). */
.dm-legend__swatch {
    width: 22px;
    height: 16px;
    margin-right: 6px;
    border-width: 2px;
    border-radius: 2px;
}

.dm-legend__swatch--here {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-gold);
}

.dm-legend__swatch--unentered {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--cd-frame);
}

/* One travellable room's click target, laid over the painted box. Deliberately frameless and
   transparent: the Painter2D rectangle underneath already says what the room is, and a button
   border on top of it read as a doubled outline. Feedback is a wash instead. */
.dm-room {
    position: absolute;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-radius: 2px;
    margin: 0;
    padding: 0;
}

.dm-room:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

/* The keyboard cursor's wash. Light rather than gold: gold is what marks the party's own room,
   and a gold wash at any readable alpha over the dark room fill blends to mud rather than to a
   highlight. The cursor's identity is the light ring DungeonMapView strokes inside the box - same
   parchment-light as .sg-node--selected on the sphere grid - and this only backs it up. */
.dm-room--selected {
    background-color: rgba(245, 240, 255, 0.16);
}

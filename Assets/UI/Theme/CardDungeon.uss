/* ============================================================
   Card Dungeon — shared UI Toolkit theme
   Reusable across every screen. Flat-color, flexbox layout
   (no fragile RectTransform anchor math). Swap the colors here
   and every screen updates.
   ============================================================ */

:root, .sg-scope {
    --cd-overlay: rgba(6, 3, 14, 0.92);
    --cd-parchment: rgb(14, 7, 28);
    --cd-frame: rgb(91, 42, 145);
    --cd-stone: rgb(35, 18, 58);
    --cd-stone-hover: rgb(104, 47, 165);
    --cd-accent: rgb(205, 110, 255);
    --cd-gold: rgb(236, 190, 72);

    --cd-text-dark: rgb(245, 240, 255);
    --cd-text-light: rgb(245, 240, 255);

    --cd-stone-disabled: rgb(26, 17, 38);
}

/* Full-screen transparent host; children position themselves. */
.cd-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

/* Compact command window, anchored toward the bottom (FFVIII-style). */
.cd-window {
    width: 620px;
    max-width: 92%;
    max-height: 62%;
    margin-bottom: 8%;
    padding: 14px 16px 16px 16px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

.cd-title {
    -unity-font-style: bold;
    font-size: 22px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* Scrollable list body — grows to fill, scrolls when overflowing. */
.cd-list {
    flex-grow: 1;
    min-height: 120px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px;
}

/* One row (magic slot, draw option, or target). A clickable button. */
.cd-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin: 3px 0;
    padding: 0 10px;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
    color: var(--cd-text-light);
}

.cd-row:hover {
    background-color: var(--cd-stone-hover);
}

.cd-row:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-row__icon {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-row__name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: var(--cd-text-light);
}

.cd-row__meta {
    flex-shrink: 0;
    width: 96px;
    font-size: 15px;
    -unity-text-align: middle-right;
    color: var(--cd-text-light);
}

/* Standard stone button (Back, actions, menu buttons). */
.cd-button {
    height: 46px;
    margin-top: 10px;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* A narrower button centered in its row (e.g. Back). */
.cd-button--narrow {
    width: 45%;
    align-self: center;
}

/* ---- Docking (absolute overlays inside .cd-root) ----
   Center the docked element by translating it, rather than stretching it with
   left/right:0 — stretching forces full width and overrides the element's own
   child alignment (which broke the command-window header and off-set dialogs). */
.cd-dock-bottom {
    position: absolute;
    bottom: 42px;
    left: 50%;
    translate: -50% 0;
}

.cd-dock-center {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

/* FF-style two-corner combat HUD: status bottom-left, command box bottom-right. */
.cd-dock-bottom-left {
    position: absolute;
    bottom: 42px;
    left: 24px;
}

.cd-dock-bottom-right {
    position: absolute;
    bottom: 42px;
    right: 24px;
}

/* Compact target/slot picker docked into the command-box corner during combat.
   Padding 0 + overflow hidden so the dark header bar sits flush like the command window. */
.cd-window--combat {
    width: 380px;
    max-width: 42%;
    max-height: 54%;
    margin-bottom: 0;
    padding: 0 0 8px 0;
    overflow: hidden;
}

/* ---- Party status window (hero names + HP) ---- */
.cd-party-status {
    min-width: 300px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-party-status__header {
    -unity-font-style: bold;
    font-size: 19px;
    padding: 9px 12px;
    color: var(--cd-gold);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 7px 10px;
}

.cd-party-status__rows {
    padding: 10px 12px;
}

.cd-party-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 7px 10px;
    margin: 2px 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-party-row__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-party-row__hp {
    font-size: 18px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 18px;
}

.cd-party-row--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-party-row--dead {
    opacity: 0.45;
}

.cd-dock-top-right {
    position: absolute;
    top: 24px;
    right: 24px;
}

/* ---- Command menu: cursor-driven vertical selection list (FFX-style) ---- */
.cd-command-list {
    padding: 8px 10px 10px 8px;
    min-width: 200px;
}

.cd-cmd-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 10px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-cmd-row:hover {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-cmd-row--selected {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-cmd-row--disabled {
    opacity: 0.4;
}

.cd-cmd-row__cursor {
    width: 22px;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-cmd-row__label {
    flex-grow: 1;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

/* ---- Turn-order list (FFX-style vertical column, top-right) ---- */
.cd-turn-order {
    width: 180px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-turn-order__header {
    -unity-font-style: bold;
    color: var(--cd-gold);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    font-size: 16px;
    padding: 7px 10px;
}

.cd-turn-order__list {
    padding: 6px;
}

.cd-turn-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 8px;
    margin: 2px 0;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-turn-row--current {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-turn-row__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    flex-shrink: 0;
    background-color: var(--cd-frame);
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-turn-row__name {
    flex-grow: 1;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Combat selection lists (magic slots / targets) — matches the command menu ---- */
.cd-select-scroll {
    flex-grow: 1;
    min-height: 60px;
    max-height: 300px;
    padding: 4px 2px;
}

.cd-sel-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 2px 0;
    padding: 0 8px 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-sel-row:hover {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-sel-row--selected {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.cd-sel-row:disabled {
    opacity: 0.4;
}

.cd-sel-row__cursor {
    width: 20px;
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
}

.cd-sel-row__icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-sel-row__name {
    flex-grow: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
    -unity-text-align: middle-left;
}

.cd-sel-row__meta {
    flex-shrink: 0;
    font-size: 14px;
    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
    margin-left: 10px;
}

/* ---- Simple bottom command bar (Examine/Action, Fight/Flee) ---- */
.cd-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
}

/* A command button used in bars and the hero command window. */
.cd-cmd {
    min-width: 120px;
    height: 46px;
    margin: 0 5px;
    padding: 0 16px;
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cmd:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cmd:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

/* ---- Hero command window (turn header + action row) ---- */
.cd-command-window {
    min-width: 560px;
    background-color: var(--cd-parchment);
    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 8px;
    overflow: hidden;
}

.cd-command-window__header {
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--cd-gold);
    background-color: var(--cd-frame);
    -unity-text-align: middle-center;
    padding: 9px 12px;
}

.cd-command-window__row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px;
}

/* ---- Dialog message body (results, death, examine detail) ---- */
.cd-message {
    white-space: normal;
    font-size: 17px;
    color: var(--cd-text-dark);
    -unity-text-align: upper-left;
    min-height: 60px;
    margin-bottom: 10px;
}

/* Detail-window button row. One button centres; two sit side by side, so a question always has
   a visible way to decline it. */
.cd-detail-buttons {
    flex-direction: row;
    justify-content: center;
}

.cd-detail-buttons > .cd-button--wide {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 45%;
    margin-left: 6px;
    margin-right: 6px;
}

/* Content-sized variant of .cd-list. Use inside .cd-window (which does not clip): a flex-grow
   scroll view spills its content container past its own box and swallows clicks on the buttons
   below it. */
.cd-list--fit {
    flex-grow: 0;
    min-height: 0;
    max-height: 260px;
}

/* The room-event odds line. Set apart from the prompt: it is the mechanical read on the gamble,
   not part of the fiction. */
.cd-event-odds {
    white-space: normal;
    font-size: 16px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* Full-width text button used for option lists (Examine/Action results). */
.cd-list-button {
    height: 44px;
    margin: 3px 0;
    -unity-font-style: bold;
    font-size: 17px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 4px;
}

.cd-list-button:hover {
    background-color: var(--cd-stone-hover);
}

/* ============================================================
   Main menu
   ============================================================ */

/* Opaque full-screen backdrop for the menu scene. */
.cd-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(20, 16, 40);
}

/* A window that centers cleanly (no lower-bias margin). */
.cd-window--flush {
    margin-bottom: 0;
}

/* Fixed-height window: for views whose content changes size between states (e.g. the inventory
   hiding its hero row/stats per tab). A constant height keeps the translate-centered window from
   re-centering, which otherwise desyncs UITK's input hit-testing from the render (clicks miss). */
.cd-window--fixed {
    height: 62%;
}

.cd-title--large {
    font-size: 34px;
    margin-bottom: 18px;
}

.cd-info-label {
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.cd-feedback {
    color: var(--cd-text-dark);
    font-size: 15px;
    -unity-text-align: middle-center;
    min-height: 20px;
    margin-top: 6px;
}

/* Compact keyboard-controls hint line (e.g. under the inventory list).
   margin-top: auto absorbs the fixed-height window's free space, anchoring the hint + the Back
   button beneath it to the bottom so they don't jump as the list content changes size. */
.cd-hint {
    font-size: 12px;
    opacity: 0.7;
    margin-top: auto;
    margin-bottom: 2px;
}

/* Hub inventory list. Unlike the combat picker (cd-select-scroll), this lives in a NON-clipping
   menu window, so it must NOT flex-grow: a stretched ScrollView content container would spill over
   and swallow clicks meant for the Back button below it. Content-sized, capped, transparent so the
   dark row text stays readable on parchment. */
.cd-inv-scroll {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 40px;
    max-height: 320px;
    padding: 4px 2px;
}

/* Hub inventory: a material and its one line of flavour, as one block. The block stretches to the
   list width, which is what gives the flavour label a width to wrap inside - a bare Label in the
   content-sized ScrollView sizes to its text instead and spills out of both sides of the window. */
.cd-inv-material {
    flex-direction: column;
    align-self: stretch;
}

.cd-inv-material__flavour {
    font-size: 13px;
    color: var(--cd-text-dark);
    opacity: 0.6;
    white-space: normal;
    -unity-text-align: middle-left;
    margin: -4px 8px 6px 54px;
}

/* Tall stacked menu button (full window width). */
.cd-menu-button {
    height: 54px;
    margin: 6px 0;
    padding: 0 18px;
    -unity-font-style: bold;
    font-size: 20px;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-menu-button:hover {
    background-color: var(--cd-stone-hover);
}

.cd-menu-button:disabled {
    background-color: var(--cd-stone-disabled);
    opacity: 0.6;
}

.cd-currency-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
    /* Never the row that gives way when the window hits its height cap — see .cd-window--tall. */
    flex-shrink: 0;
}

.cd-currency-row > Label {
    margin: 0 12px;
    color: var(--cd-text-dark);
    font-size: 16px;
    -unity-font-style: bold;
}

.cd-button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

/* ---- Forge: tabs ---- */
.cd-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.cd-tab {
    padding: 6px 20px;
    margin: 0 4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-tab:hover {
    background-color: var(--cd-stone-hover);
}

.cd-tab--active {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

/* ---- Forge: collection grid ---- */
.cd-grid-scroll {
    flex-grow: 1;
    min-height: 220px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px;
}

/* Make the scroll view's content lay cells out in a wrapping grid. */
.cd-grid-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.cd-cell {
    width: 68px;
    height: 68px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.cd-cell:hover {
    background-color: var(--cd-stone-hover);
}

.cd-cell--locked {
    background-color: var(--cd-stone-disabled);
}

.cd-cell__icon {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-cell__q {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
}

/* ---- Forge: inspect panel ---- */
.cd-inspect {
    flex-grow: 1;
}

.cd-inspect__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cd-inspect__icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: var(--cd-stone);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-inspect__titlecol {
    flex-grow: 1;
}

.cd-inspect__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__level {
    font-size: 14px;
    color: var(--cd-text-dark);
}

.cd-inspect__desc {
    white-space: normal;
    font-size: 14px;
    color: var(--cd-text-dark);
    margin-bottom: 8px;
}

.cd-inspect__effects {
    margin-bottom: 8px;
}

.cd-effect-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 6px;
    margin: 2px 0;
    background-color: rgba(41, 31, 20, 0.22);
    border-radius: 3px;
}

.cd-effect-row--locked {
    opacity: 0.5;
}

.cd-effect-row__text {
    font-size: 13px;
    color: var(--cd-text-dark);
}

.cd-effect-row__lock {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-inspect__actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.cd-inspect__actions > .cd-button--narrow {
    margin-right: 8px;
}

/* ---- Victory summary (shown over the battle stage) ---- */

.cd-victory {
    width: 600px;
    max-width: 90%;
    padding: 0 0 24px 0;

    background-color: var(--cd-parchment);

    border-width: 4px;
    border-color: var(--cd-frame);
    border-radius: 14px;

    overflow: hidden;
    align-items: center;
}

.cd-victory__title {
    width: 100%;

    -unity-font-style: bold;
    font-size: 38px;

    color: var(--cd-text-light);
    background-color: var(--cd-frame);

    -unity-text-align: middle-center;

    padding: 16px 0;
    margin-bottom: 18px;
}

.cd-victory__rewards {
    width: 100%;

    padding: 0 34px;
    margin-bottom: 16px;
}

.cd-victory-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding: 13px 6px;
    margin: 3px 0;

    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-victory-row__label {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--cd-text-dark);
}

.cd-victory-row__value {
    font-size: 22px;
    -unity-font-style: bold;

    color: var(--cd-text-dark);
    -unity-text-align: middle-right;
}

.cd-victory-loot {
    flex-direction: row;
    align-items: center;

    padding: 6px 6px 6px 20px;
}

.cd-victory-loot__icon {
    width: 32px;
    height: 32px;

    margin-right: 10px;
    flex-shrink: 0;

    -unity-background-scale-mode: scale-to-fit;
}

.cd-victory-loot__name {
    font-size: 18px;
    color: var(--cd-text-dark);
}

/* Boss encounter banner — top-center, announces the climax fight. */
.cd-boss-banner {
    position: absolute;
    top: 48px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    padding: 10px 34px;
    background-color: rgba(40, 8, 10, 0.9);
    border-width: 2px;
    border-color: rgb(150, 40, 40);
    border-radius: 6px;
}

.cd-boss-banner__sub {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(224, 120, 110);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.cd-boss-banner__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
}

/* Merchant gear shop (buy/sell rows). */
.cd-subtitle {
    -unity-font-style: bold;
    font-size: 15px;
    color: var(--cd-text-dark);
    margin-top: 10px;
    margin-bottom: 2px;
}

.cd-shop-list {
    max-height: 150px;
    margin-bottom: 2px;
}

.cd-shop-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    margin: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 22, 0.22);
}

.cd-shop-row__icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-shop-row__name {
    flex-grow: 1;
    font-size: 14px;
    color: var(--cd-text-dark);
}

.cd-shop-row__sub {
    font-size: 11px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    opacity: 0.75;
    white-space: normal;
}

.cd-shop-row__btn {
    flex-shrink: 0;
    min-width: 96px;
}

/* Party select: a left accent bar so fielded and benched rows are distinguishable
   without reading the button. */
.cd-party-row--fielded {
    border-left-width: 3px;
    border-left-color: var(--cd-frame);
    padding-left: 5px;
}

.cd-party-row--benched {
    opacity: 0.72;
}

.cd-shop-empty {
    font-size: 13px;
    -unity-font-style: italic;
    color: var(--cd-text-dark);
    padding: 6px 4px;
}

/* Utility: hidden (controller toggles this). */
.cd-hidden {
    display: none;
}

.cd-command-window,
.cd-party-status,
.cd-turn-order {
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--cd-frame);
}

.cd-cmd-row,
.cd-sel-row,
.cd-party-row,
.cd-turn-row {
    border-radius: 8px;
}

.cd-button {
    border-radius: 10px;
}

/* Bright active selection */

.cd-cmd-row--selected,
.cd-sel-row--selected,
.cd-party-row--active,
.cd-turn-row--current {
    background-color: rgb(102, 48, 158);
    border-width: 2px;
    border-color: var(--cd-accent);
    border-radius: 8px;
}

/* Hover */

.cd-cmd-row:hover,
.cd-sel-row:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

/* Brighter glossy-looking headers */

.cd-party-status__header,
.cd-turn-order__header,
.cd-command-window__header {
    background-color: rgb(67, 30, 108);
    color: var(--cd-gold);

    border-bottom-width: 1px;
    border-bottom-color: var(--cd-accent);
}

/* ============================================================
   Enemy knowledge ("Scan") — the in-combat Inspect page and the
   hub bestiary render the same rows, so they share these classes.
   Tone classes come from BestiaryLineView.ToneClass; nothing else
   should decide what a known/unknown value looks like.
   ============================================================ */

.cd-scan__header {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgb(67, 30, 108);
    border-bottom-width: 1px;
    border-bottom-color: var(--cd-accent);
}

.cd-scan__portrait {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    background-color: var(--cd-stone);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-scan__titlecol {
    flex-grow: 1;
}

.cd-scan__name {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--cd-gold);
}

.cd-scan__health {
    font-size: 15px;
    color: var(--cd-text-light);
}

.cd-scan__body {
    flex-grow: 1;
    min-height: 140px;
    max-height: 320px;
    margin: 8px 12px;
    padding: 6px 8px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
}

/* A section heading inside the page ("Resistances", "Draw", ...). */
.cd-scan__section {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--cd-accent);
    margin-top: 8px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 110, 255, 0.35);
}

.cd-scan__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 4px;
}

.cd-scan__label {
    font-size: 15px;
    color: var(--cd-text-light);
}

.cd-scan__value {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* In the player's favour — a weakness to exploit, loot they have seen drop. */
.cd-scan__value--good {
    color: rgb(255, 217, 102);
}

/* Against the player — resisted, immune, absorbed, or an element aimed at the party. */
.cd-scan__value--bad {
    color: rgb(154, 178, 217);
}

.cd-scan__value--neutral {
    color: var(--cd-text-light);
}

/* Not yet observed. Dim on purpose: an unread row should read as a gap in the record,
   not as a value. */
.cd-scan__value--unknown {
    color: rgb(122, 106, 146);
}

/* ---- Hub bestiary ---- */

.cd-bestiary__cols {
    flex-direction: row;
    flex-grow: 1;
    min-height: 300px;
}

.cd-bestiary__list {
    width: 40%;
    margin-right: 10px;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px;
}

.cd-bestiary__detail {
    flex-grow: 1;
    background-color: rgba(41, 31, 20, 0.35);
    border-radius: 4px;
    padding: 6px 10px;
}

/* An enemy row in the left-hand list. */
.cd-bestiary-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 2px 0;
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.cd-bestiary-row:hover {
    background-color: rgb(71, 34, 110);
    border-color: rgb(156, 82, 210);
}

.cd-bestiary-row--selected {
    background-color: rgb(102, 48, 158);
    border-color: var(--cd-accent);
}

/* Never met: still listed, so the collection has a visible shape. */
.cd-bestiary-row--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.75;
}

.cd-bestiary-row__icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.cd-bestiary-row__name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
}

.cd-bestiary-row__kills {
    font-size: 13px;
    color: rgb(180, 164, 204);
}

/* ============================================================
   Sphere grid — shared graph view (hub screen + editor window)

   Restored after the dark-theme pass dropped the tail of this file; the
   graph screens render nothing without it (see .sg-viewport / .sg-node).
   Everything below is expressed in --cd-* tokens so it follows the theme,
   except the two inset panel fills, which are deliberate blacks.
   ============================================================ */

/* A wider window: the pannable graph plus its detail panel need more than 620px. */
.cd-window--wide {
    width: 1140px;
}

/* The graph viewport. overflow:hidden clips the pannable content, so nothing can spill
   out and swallow clicks meant for the buttons beneath it (the ScrollView trap). */
.sg-viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* The panned/zoomed content plane. transform-origin must be the top-left corner:
   UITK's default is 50% 50%, which makes scaling orbit the element's center and
   desyncs the zoom-toward-cursor math. */
.sg-content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: left top;
}

.sg-node {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: var(--cd-frame);
    align-items: center;
    justify-content: center;
    background-color: var(--cd-stone-disabled);
    margin: 0;
    padding: 0;
}

.sg-node:hover {
    border-color: var(--cd-accent);
}

/* Activation states (SphereGridPresenter.StateClass drives these). */
.sg-node--activated {
    background-color: var(--cd-accent);
}

.sg-node--available {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

.sg-node--adjacent {
    background-color: var(--cd-stone);
}

.sg-node--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.45;
}

.sg-node--selected {
    border-color: var(--cd-text-light);
    scale: 1.15;
}

/* Editor connect-mode source highlight. Gold rather than the theme's parchment, which is
   now a near-black ink and would read as no highlight at all. */
.sg-node--source {
    border-color: var(--cd-gold);
}

/* Kind accents. */
.sg-node--start {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    border-width: 4px;
}

.sg-node__glyph {
    color: var(--cd-text-light);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* Filled nodes are the theme's brightest surfaces, so their glyph flips to dark ink —
   --cd-text-dark is itself near-white in this theme and would vanish. */
.sg-node--activated .sg-node__glyph {
    color: var(--cd-parchment);
}

/* Screen layout: graph on the left, always-present detail panel on the right, so the
   window's size never changes between states (the dock-center hit-test trap). */
.sg-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
}

.sg-detail {
    width: 300px;
    flex-shrink: 0;
    margin-left: 10px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

/* ---- Campaign map ---- */
/* The map reuses SphereGridView, so nodes keep the .sg-node geometry and only the state
   vocabulary differs (CampaignPresenter.StateClasses drives these). Separate class names
   rather than reusing sg-node--* so the two graphs cannot clear each other's states. */

.cm-node--completed {
    background-color: var(--cd-accent);
}

.cm-node--available {
    background-color: var(--cd-stone-hover);
    border-color: var(--cd-accent);
}

/* The run underway: gold fill so it reads as "you are here" at a glance. */
.cm-node--active {
    background-color: var(--cd-gold);
    border-color: var(--cd-text-light);
}

.cm-node--locked {
    background-color: var(--cd-stone-disabled);
    opacity: 0.45;
}

/* Optional side branches are outlined rather than filled, so the main line reads first. */
.cm-node--optional {
    border-color: var(--cd-stone-hover);
}

.cm-node--completed .sg-node__glyph,
.cm-node--active .sg-node__glyph {
    color: var(--cd-parchment);
}

/* ---- Home window sizing ---- */
/* Home stacks ten menu buttons plus the purse. At the shared 62% cap the flex layout
   ran out of room and squeezed the last child to zero height, so Gold/Essence rendered outside
   the frame. The purse must never be the row that gives way, and the window needs the headroom.
   Measured in play mode (2026-09-01): the content is 799.5 units against this 884.4 cap, so there
   is room for roughly ONE more button. Do not raise the cap much past 88% to buy more - .cd-window
   also carries margin-bottom: 8%, so 92% puts the frame against the top edge. */

.cd-window--tall {
    max-height: 88%;
}

/* ---- Options: stepped dials ----
   The volume rows are buttons rather than a UITK Slider on purpose: the hub's keyboard cursor
   navigates buttons, so a slider would be a hole in a screen the player is meant to be able to
   reach without a mouse. A step is 10% — see AudioOptions.Step. */

.cd-option-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
}

.cd-option-label {
    flex-grow: 1;
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-font-style: bold;
}

.cd-option-value {
    width: 70px;
    color: var(--cd-text-dark);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* A square nudge button. Fixed width so the two sit either side of the readout without the row
   reflowing as the number changes width (9% and 100% are different sizes). */
.cd-button--step {
    width: 52px;
    height: 40px;
    margin-top: 0;
    padding: 0;
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* ============================================================
   The hub town (HubView). One authored pixel rect, letterboxed
   as a single unit — the scale lives on .hub-canvas, never on a
   lot, because UITK applies a transform to hit-testing as well
   as to paint, and scaling lots individually is what desyncs a
   click from the pixel it landed on.

   Every lot is a flat rectangle until BuildingSO carries real
   sprites: that is the placeholder-art bargain HUB.md §7 phase 3
   assumed, and it is why the glyph and label matter — they are
   the only thing telling the Forge from the Bestiary.
   ============================================================ */

/* The town is the screen, not a window on it: full-bleed, with every service docking over it.
   That is also why home no longer has to fit ten buttons inside a 62%-tall frame. */
.hub-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    flex-direction: column;
}

.hub-town {
    flex-grow: 1;
}

.hub-view__viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(9, 5, 18);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
}

.hub-canvas {
    overflow: visible;
}

.hub-backdrop {
    background-color: rgb(18, 10, 34);
    -unity-background-scale-mode: scale-and-crop;
}

/* One building's sprite. Its own layer beneath the hit boxes, so silhouettes may overlap
   each other and spill past the box you click - which is what makes a town look painted
   rather than tiled. Never picks: input belongs to .hub-lot above it. */
.hub-art {
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.28s, 0.28s;
    transition-timing-function: ease-out, ease-out;
}

/* An unbuilt lot's foundation still has to be seen - it is the affordance that makes a
   material worth wanting, so it is dimmed only enough to read as unfinished. */
.hub-art.hub-lot--available {
    opacity: 0.92;
}

.hub-art.hub-lot--absent {
    opacity: 0.28;
}

/* Nothing authored yet: draw no ghost box, let the flat .hub-lot slab do the work. */
.hub-art--empty {
    background-color: rgba(0, 0, 0, 0);
}

/* The build animation, and it works the way round you might not expect: this is the
   STARTING state. HubView adds it, lets a frame lay out, then removes it - the sprite
   then transitions from here back to its resting opacity and scale. Done the other way
   (a class that sets the end state) nothing moves, because the end state is the default
   and a USS transition only runs on a change. */
.hub-art--phasing {
    opacity: 0;
    scale: 0.82 0.82;
}

.hub-lot {
    background-color: var(--cd-stone);
    border-width: 2px;
    border-color: var(--cd-frame);
    border-radius: 6px;
    padding: 6px;
    margin: 0;
    color: var(--cd-text-light);
    align-items: center;
    justify-content: flex-end;
    -unity-background-scale-mode: scale-to-fit;
}

.hub-lot:hover {
    background-color: var(--cd-stone-hover);
}

/* A lot carrying real art keeps the sprite, not the slab. */
.hub-lot--art {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hub-lot__glyph {
    font-size: 34px;
    color: var(--cd-accent);
    -unity-text-align: middle-center;
}

.hub-lot__label {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--cd-text-light);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(9, 5, 18, 0.8);
    padding: 0 6px;
    border-radius: 3px;
}

.hub-lot__note {
    font-size: 12px;
    color: var(--cd-gold);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(9, 5, 18, 0.8);
    padding: 0 5px;
    border-radius: 3px;
}

/* Built is the ordinary state. Available is a bare foundation — it has to read
   as an invitation, which is the whole reason a material is worth wanting. */
.hub-lot--available {
    background-color: rgba(35, 18, 58, 0.45);
    border-color: rgb(70, 52, 96);
}

.hub-lot--available .hub-lot__glyph {
    color: rgb(96, 78, 122);
}

.hub-lot--absent {
    background-color: rgba(20, 12, 32, 0.35);
    border-color: rgb(44, 32, 62);
    opacity: 0.55;
}

/* The road out of town. Not a lot: the story is the way out, not a service, and
   a building must never be able to lock the player out of running. */
.hub-road {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -50%;
    width: 150px;
    height: 190px;
    margin: 0;
    background-color: var(--cd-stone);
    border-width: 3px;
    border-color: var(--cd-gold);
    border-radius: 6px;
    color: var(--cd-gold);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 8px;
    white-space: normal;
}

.hub-road:hover {
    background-color: var(--cd-stone-hover);
}

.hub-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 8px;
}

/* .cd-button--narrow is 45% of its parent, which is the whole screen width down here.
   The bar is a row, so its buttons size to their content instead. */
.hub-bar .cd-button {
    width: auto;
    align-self: center;
    margin-top: 0;
}

.hub-bar .cd-feedback {
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin: 0 12px;
}

/* ============================================================
   Keyboard cursor — the arrow-key highlight painted by
   ImmoralityGaming.Menu.KeyboardNavigator on whichever button
   the cursor is on. Deliberately the last rule in the file:
   every button class here (.cd-menu-button, .cd-button, .cd-tab,
   the shop-row buttons) is a single-class selector of equal
   specificity, so source order is what makes the cursor win over
   the button's own background. Border width matches theirs (2px)
   so highlighting never nudges a layout.
   ============================================================ */

.cd-nav--selected {
    background-color: rgb(102, 48, 158);
    border-width: 2px;
    border-color: var(--cd-accent);
    color: var(--cd-gold);
}

.cd-nav--selected:hover {
    background-color: rgb(126, 62, 190);
    border-color: rgb(156, 82, 210);
}

.cd-nav--selected:disabled {
    background-color: var(--cd-stone-disabled);
    border-color: var(--cd-frame);
}

/* Keyboard hint line, bottom-centre under the room bar. Deliberately quiet:
   it is there to be found once, not read every room. */
.cd-nav-hint {
    position: absolute;
    bottom: 12px;
    left: 50%;
    translate: -50% 0;
    font-size: 12px;
    color: var(--cd-text-dark);
    opacity: 0.7;
}

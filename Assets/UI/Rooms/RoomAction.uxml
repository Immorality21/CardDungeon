<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Theme/CardDungeon.uss" />

    <ui:VisualElement name="root" class="cd-root" picking-mode="Ignore">

        <!-- Non-combat room actions -->
        <ui:VisualElement name="main-bar" class="cd-bar cd-dock-bottom cd-hidden">
            <ui:Button name="action-btn" text="Action" class="cd-cmd" />
            <ui:Button name="search-btn" text="Search" class="cd-cmd cd-hidden" />
            <ui:Button name="rest-btn" text="Rest" class="cd-cmd cd-hidden" />
            <ui:Button name="rescue-btn" text="Rescue" class="cd-cmd cd-hidden" />
            <ui:Button name="descend-btn" text="Descend" class="cd-cmd cd-hidden" />
        </ui:VisualElement>

        <!-- Enemies present: start or flee -->
        <ui:VisualElement name="combat-bar" class="cd-bar cd-dock-bottom cd-hidden">
            <ui:Button name="fight-btn" text="Fight" class="cd-cmd" />
            <ui:Button name="flee-btn" text="Flee" class="cd-cmd" />
        </ui:VisualElement>

        <!-- Boss encounter banner (top-center): announces the climax fight while the player
             decides to engage; hidden once combat starts. -->
        <ui:VisualElement name="boss-banner" class="cd-boss-banner cd-hidden" picking-mode="Ignore">
            <ui:Label name="boss-banner-sub" text="BOSS" class="cd-boss-banner__sub" />
            <ui:Label name="boss-banner-name" text="" class="cd-boss-banner__name" />
        </ui:VisualElement>

        <!-- Turn-order list (FFX-style, top-right): upcoming turns, current on top -->
        <ui:VisualElement name="turn-order" class="cd-turn-order cd-dock-top-right cd-hidden">
            <ui:Label name="turn-order-title" text="Turn Order" class="cd-turn-order__header" />
            <ui:VisualElement name="turn-order-list" class="cd-turn-order__list" />
        </ui:VisualElement>

        <!-- Party status window (FF-style, bottom-right): hero names + HP -->
        <ui:VisualElement name="party-status" class="cd-party-status cd-dock-bottom-right cd-hidden">
            <ui:Label name="party-status-title" text="Party" class="cd-party-status__header" />
            <ui:VisualElement name="party-status-rows" class="cd-party-status__rows" />
        </ui:VisualElement>

        <!-- Hero turn command menu (FFX-style, bottom-left): a cursor-driven selection list -->
        <ui:VisualElement name="hero-bar" class="cd-command-window cd-dock-bottom-left cd-hidden">
            <ui:Label name="hero-title" text="" class="cd-command-window__header" />
            <ui:VisualElement name="command-list" class="cd-command-list" />
        </ui:VisualElement>

        <!-- Room event: the prompt, how well the party can read its odds, and the choices -->
        <ui:VisualElement name="event-window" class="cd-window cd-dock-center cd-hidden">
            <ui:Label name="event-title" text="" class="cd-title" />
            <ui:Label name="event-prompt" text="" class="cd-message" />
            <ui:Label name="event-odds" text="" class="cd-event-odds" />
            <!-- The fit variant keeps this list content-sized: a flex-grow list inside a window
                 that does not clip spills over the Back button below and eats its clicks. -->
            <ui:ScrollView name="event-options" class="cd-list cd-list--fit" mode="Vertical" />
            <ui:Button name="event-back" text="Back" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

        <!-- Detail / result / death dialog -->
        <ui:VisualElement name="detail-window" class="cd-window cd-dock-center cd-hidden">
            <ui:Label name="detail-title" text="" class="cd-title" />
            <ui:Label name="detail-message" text="" class="cd-message" />
            <ui:VisualElement name="detail-buttons" class="cd-detail-buttons">
                <ui:Button name="detail-ok" text="Ok" class="cd-button cd-button--wide" />
                <ui:Button name="detail-cancel" text="Cancel" class="cd-button cd-button--wide cd-hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Victory summary (shown over the battle stage) -->
        <ui:VisualElement name="victory-window" class="cd-victory cd-dock-center cd-hidden">
            <ui:Label name="victory-title" text="Victory!" class="cd-victory__title" />
            <ui:VisualElement name="victory-rewards" class="cd-victory__rewards" />
            <ui:Button name="victory-continue" text="Continue" class="cd-button cd-button--narrow" />
        </ui:VisualElement>

        <!-- Pause overlay. Last in the document so it paints over everything else, and the only
             window that can come up on top of a fight. Holds what the hub owns between runs but
             the dungeon had no way to reach: the audio dials, and the way out.

             The audio rows carry the same element names as MainMenu.uxml's options-view, because
             AudioOptionsUI is a plain view-controller that queries its root by name - so the dungeon
             gets the hub's dials with no second implementation to drift. -->
        <ui:VisualElement name="pause-window" class="cd-window cd-window--flush cd-dock-center cd-hidden">
            <ui:Label text="Paused" class="cd-title" />

            <ui:Label text="Audio" class="cd-subtitle" />
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Master" class="cd-option-label" />
                <ui:Button name="master-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="master-value" text="" class="cd-option-value" />
                <ui:Button name="master-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Music" class="cd-option-label" />
                <ui:Button name="music-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="music-value" text="" class="cd-option-value" />
                <ui:Button name="music-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>
            <ui:VisualElement class="cd-option-row">
                <ui:Label text="Sound Effects" class="cd-option-label" />
                <ui:Button name="sfx-down" text="-" class="cd-button cd-button--step" />
                <ui:Label name="sfx-value" text="" class="cd-option-value" />
                <ui:Button name="sfx-up" text="+" class="cd-button cd-button--step" />
            </ui:VisualElement>
            <ui:Button name="options-mute" text="" class="cd-menu-button" />

            <ui:Button name="pause-resume" text="Resume" class="cd-button cd-button--wide" />
            <ui:Button name="pause-quit" text="Leave the Dungeon" class="cd-button cd-button--wide" />
            <ui:Label name="pause-note" text="" class="cd-info-label cd-hint" />
        </ui:VisualElement>

        <!-- Keyboard hint. Shown only while the arrows actually mean "pick a door". -->
        <ui:Label name="nav-hint" text="Arrows pick a door &#183; Enter walk through &#183; Tab room actions" class="cd-nav-hint cd-hidden" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
